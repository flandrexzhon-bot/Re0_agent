@page "/agents"
@using Microsoft.EntityFrameworkCore
@using Re0Agent.Core.Entities
@using Re0Agent.Core.Database
@using System.Text.Json
@using System.Text
@inject Re0AgentDbContext DbContext

<PageTitle>契约之书 - API 预设配置</PageTitle>

<div class="fate-book">
    <section class="page-heading">
        <h1>契约之书</h1>
        <p>在此撰写各个大语言模型的通灵契约，配置端点与密钥，为世界线的流转提供源力储备。</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="work-surface" style="border-color: var(--color-gold); padding: 0.75rem 1.25rem;">
            <p style="color: var(--color-gold-glow); margin: 0;">✨ @statusMessage</p>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="work-surface error-panel" style="padding: 0.75rem 1.25rem;">
            <p style="margin: 0;">⚠️ @errorMessage</p>
        </div>
    }

    <div style="display: grid; grid-template-columns: 280px 1fr; gap: 1.5rem; margin-top: 1rem;">
        
        <!-- 左侧预设列表 -->
        <div>
            <div class="work-surface" style="padding: 1rem; min-height: 550px; display: flex; flex-direction: column;">
                <h3 style="font-size: 1.15rem; margin-bottom: 1rem; border-bottom: 1px solid rgba(84, 56, 44, 0.4); padding-bottom: 0.5rem;">API 模型预设</h3>
                
                <div style="display: flex; flex-direction: column; gap: 0.50rem; flex: 1; overflow-y: auto; max-height: 420px;">
                    @foreach (var config in agentConfigs)
                    {
                        <div class="status-panel @(selectedConfig?.ConfigId == config.ConfigId ? "active-contract" : "")" 
                             style="cursor: pointer; padding: 0.75rem; border-color: @(selectedConfig?.ConfigId == config.ConfigId ? "var(--color-gold-glow)" : "var(--border-vintage)");"
                             @onclick="() => SelectConfig(config)">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <strong style="font-size: 0.95rem; color: @(selectedConfig?.ConfigId == config.ConfigId ? "var(--color-gold-glow)" : "var(--color-gold)");">
                                    @config.AgentName
                                </strong>
                                @if (config.Enabled == 1)
                                {
                                    <span class="badge" style="font-size: 0.7rem; background: rgba(40, 167, 69, 0.15); color: #28a745; padding: 0.15rem 0.35rem; border-radius: 3px;">
                                        已启用
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="font-size: 0.7rem; background: rgba(220, 53, 69, 0.15); color: #dc3545; padding: 0.15rem 0.35rem; border-radius: 3px;">
                                        停用
                                    </span>
                                }
                            </div>
                            <span style="font-size: 0.75rem; margin-top: 0.25rem; display: block; color: var(--color-text-secondary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @config.ModelName
                            </span>
                        </div>
                    }
                </div>

                <button type="button" class="btn-custom" style="width: 100%; margin-top: 1.5rem; font-size: 0.85rem;" @onclick="CreateNewConfig" disabled="@isBusy">
                    ＋ 缔结新契约
                </button>
            </div>
        </div>

        <!-- 右侧预设详情与编辑 -->
        <div>
            @if (selectedConfig is not null)
            {
                <div class="work-surface" style="min-height: 550px;">
                    <h2 style="display: flex; justify-content: space-between; align-items: center;">
                        <span>契约详情：@selectedConfig.AgentName</span>
                        @if (selectedConfig.ConfigId > 0)
                        {
                            <button type="button" class="danger-action" style="font-size: 0.75rem; padding: 0.3rem 0.75rem;" @onclick="DeleteConfigAsync" disabled="@isBusy">
                                解除契约
                            </button>
                        }
                    </h2>

                    <div style="display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1rem;">
                        <div>
                            <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">预设名称 (用于首页路由绑定标识)</label>
                            <input type="text" @bind="selectedConfig.AgentName" placeholder="例如：Claude 3.5, 自建本地大模型" />
                        </div>
                    </div>

                    <div style="margin-top: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                            <label style="font-size: 0.85rem; color: var(--color-text-secondary);">契约模板快捷加载</label>
                            <div style="display: flex; gap: 0.35rem;">
                                <button type="button" class="btn-custom" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;" @onclick='() => ApplyPreset("google")'>Google AI</button>
                                <button type="button" class="btn-custom" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;" @onclick='() => ApplyPreset("deepseek")'>DeepSeek</button>
                                <button type="button" class="btn-custom" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;" @onclick='() => ApplyPreset("openai")'>OpenAI</button>
                                <button type="button" class="btn-custom" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;" @onclick='() => ApplyPreset("ollama")'>Ollama</button>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top: 1rem;">
                        <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">魔力端点 (OpenAI API URL)</label>
                        <input type="text" @bind="selectedConfig.ApiEndpoint" placeholder="https://api.openai.com/v1" />
                    </div>

                    <div style="margin-top: 1rem;">
                        <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">通灵密钥 (OpenAI API Key)</label>
                        <div style="position: relative; display: flex; align-items: center;">
                            <input type="@(showApiKey ? "text" : "password")" @bind="selectedConfig.ApiKey" placeholder="API Key" style="padding-right: 2.5rem;" />
                            <button type="button" style="position: absolute; right: 5px; background: transparent; border: none; box-shadow: none; color: var(--color-gold); cursor: pointer; padding: 5px;" 
                                    @onclick="() => showApiKey = !showApiKey">
                                @(showApiKey ? "👁️" : "🙈")
                            </button>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; margin-top: 1rem;">
                        <div>
                            <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">魂核模型 (Model Name)</label>
                            <div style="display: flex; gap: 0.5rem;">
                                <input type="text" @bind="selectedConfig.ModelName" placeholder="gpt-4o" style="flex: 1;" />
                                <button type="button" class="btn-custom" style="font-size: 0.8rem; margin: 0; padding: 0.35rem 0.75rem;" 
                                        @onclick="FetchModelListAsync" disabled="@isBusy">
                                    获取模型列表
                                </button>
                            </div>
                            @if (fetchedModels.Count > 0)
                            {
                                <div style="margin-top: 0.35rem;">
                                    <select @onchange="OnFetchedModelSelected" style="font-size: 0.85rem; padding: 0.25rem;">
                                        <option value="">-- 一键选中已拉取模型 --</option>
                                        @foreach (var m in fetchedModels)
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">灵性温度 (Temp)</label>
                            <input type="number" step="0.1" min="0" max="2" @bind="selectedConfig.Temperature" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                        <div>
                            <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">输入 Token 限制</label>
                            <input type="number" step="1000" min="256" @bind="selectedConfig.MaxInputTokens" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">输出 Token 限制 (Max)</label>
                            <input type="number" step="256" min="256" @bind="selectedConfig.MaxTokens" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">响应格式</label>
                            <select @bind="selectedConfig.ResponseFormat">
                                <option value="JSON">JSON 格式</option>
                                <option value="Text">纯文本格式</option>
                            </select>
                        </div>
                    </div>

                    <div style="margin-top: 1rem;">
                        <label style="display: block; font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 0.35rem;">契约咒文 (System Prompt - 选填)</label>
                        <textarea rows="4" @bind="selectedConfig.SystemPrompt" placeholder="可选的系统级 System Prompt..."></textarea>
                    </div>

                    <!-- 连接测试面板 -->
                    @if (connectionTestSuccess != null)
                    {
                        <div class="work-surface" style="margin-top: 1rem; padding: 0.75rem; border-color: @(connectionTestSuccess.Value ? "#28a745" : "#dc3545");">
                            <h4 style="font-size: 0.9rem; margin-bottom: 0.25rem; color: @(connectionTestSuccess.Value ? "#28a745" : "#dc3545");">
                                @(connectionTestSuccess.Value ? "💚 连接测试通过" : "💔 连接测试失败")
                            </h4>
                            <p style="font-size: 0.8rem; margin: 0; font-family: monospace; white-space: pre-wrap; word-break: break-all; color: var(--color-text-secondary);">
                                @connectionTestResult
                            </p>
                        </div>
                    }

                    <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(84, 56, 44, 0.4);">
                        <label class="inline-toggle">
                            <input type="checkbox" @bind="selectedConfigEnabled" />
                            <span>启用该契约</span>
                        </label>
                        
                        <div style="display: flex; gap: 0.75rem;">
                            <button type="button" class="btn-custom" style="margin: 0;" @onclick="TestConnectionAsync" disabled="@isBusy">
                                @(isTestingConnection ? "正在通灵..." : "⚡ 预置连接测试")
                            </button>
                            <button type="button" class="primary-action" style="margin: 0;" @onclick="SaveConfigAsync" disabled="@isBusy">
                                保存契约印章
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="work-surface" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 550px; color: var(--color-text-secondary);">
                    <span style="font-size: 3rem; margin-bottom: 1rem;">📜</span>
                    <p>在左侧选择一份 API 模型预设，或点击按钮缔结新的魔力契约。</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .active-contract {
        border-color: var(--color-gold-glow) !important;
        box-shadow: 0 0 10px rgba(255, 223, 158, 0.2), inset 0 0 8px rgba(0,0,0,0.5) !important;
        background: var(--bg-card) !important;
    }
</style>

@code {
    private List<Re0Agent.Core.Entities.AgentConfig> agentConfigs = new();
    private Re0Agent.Core.Entities.AgentConfig? selectedConfig;
    private bool selectedConfigEnabled;
    private bool showApiKey;
    private string? statusMessage;
    private string? errorMessage;
    private bool isBusy = false;

    private List<string> fetchedModels = new();
    private bool isTestingConnection = false;
    private bool? connectionTestSuccess;
    private string? connectionTestResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigsAsync();
        if (agentConfigs.Count > 0)
        {
            SelectConfig(agentConfigs[0]);
        }
    }

    private async Task LoadConfigsAsync()
    {
        try
        {
            agentConfigs = await DbContext.AgentConfig.OrderBy(c => c.AgentName).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"加载契约法典失败: {ex.Message}";
        }
    }

    private void SelectConfig(Re0Agent.Core.Entities.AgentConfig config)
    {
        selectedConfig = config;
        selectedConfigEnabled = config.Enabled == 1;
        showApiKey = false;
        statusMessage = null;
        errorMessage = null;
        fetchedModels.Clear();
        connectionTestSuccess = null;
        connectionTestResult = null;
    }

    private void CreateNewConfig()
    {
        selectedConfig = new Re0Agent.Core.Entities.AgentConfig
        {
            AgentName = "新大语言模型预设",
            AgentType = "Character", // Bypasses sqlite agent_type constraint
            ApiEndpoint = "https://api.openai.com/v1",
            ApiKey = "",
            ModelName = "gpt-4o-mini",
            Temperature = 0.7,
            MaxTokens = 4096,
            MaxInputTokens = 4096,
            ResponseFormat = "JSON",
            SystemPrompt = "",
            Enabled = 1
        };
        selectedConfigEnabled = true;
        showApiKey = true;
        statusMessage = "拟定了一份新契约，请填入内容后点击保存。";
        errorMessage = null;
        fetchedModels.Clear();
        connectionTestSuccess = null;
        connectionTestResult = null;
    }

    private async Task SaveConfigAsync()
    {
        if (selectedConfig is null) return;

        statusMessage = null;
        errorMessage = null;
        isBusy = true;

        if (string.IsNullOrWhiteSpace(selectedConfig.AgentName))
        {
            errorMessage = "契约的名称不能为空。";
            isBusy = false;
            return;
        }

        try
        {
            selectedConfig.Enabled = selectedConfigEnabled ? 1 : 0;
            selectedConfig.AgentType = "Character"; // ensure default

            if (selectedConfig.ConfigId == 0)
            {
                // check uniqueness
                var exists = await DbContext.AgentConfig.AnyAsync(c => c.AgentName == selectedConfig.AgentName);
                if (exists)
                {
                    errorMessage = $"已存在名称为 {selectedConfig.AgentName} 的契约。";
                    isBusy = false;
                    return;
                }
                DbContext.AgentConfig.Add(selectedConfig);
            }
            else
            {
                DbContext.AgentConfig.Update(selectedConfig);
            }

            await DbContext.SaveChangesAsync();
            statusMessage = $"预设“{selectedConfig.AgentName}”已成功铭刻保存。";
            await LoadConfigsAsync();
            
            // Re-select newly saved
            var saved = agentConfigs.FirstOrDefault(c => c.AgentName == selectedConfig.AgentName);
            if (saved is not null)
            {
                SelectConfig(saved);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"保存契约发生错误: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteConfigAsync()
    {
        if (selectedConfig is null || selectedConfig.ConfigId == 0) return;

        statusMessage = null;
        errorMessage = null;
        isBusy = true;

        try
        {
            // Also delete any routing mapping to this preset
            var routings = await DbContext.ApiRoutings.Where(r => r.PresetName == selectedConfig.AgentName).ToListAsync();
            if (routings.Any())
            {
                DbContext.ApiRoutings.RemoveRange(routings);
            }

            DbContext.AgentConfig.Remove(selectedConfig);
            await DbContext.SaveChangesAsync();
            statusMessage = $"预设“{selectedConfig.AgentName}”已成功解除（删除）。";
            selectedConfig = null;
            await LoadConfigsAsync();
            if (agentConfigs.Count > 0)
            {
                SelectConfig(agentConfigs[0]);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"解除契约发生错误: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ApplyPreset(string provider)
    {
        if (selectedConfig is null) return;

        switch (provider)
        {
            case "google":
                selectedConfig.ApiEndpoint = "https://generativelanguage.googleapis.com/v1beta/openai";
                selectedConfig.ModelName = "gemini-1.5-flash";
                selectedConfig.MaxTokens = 8192;
                selectedConfig.MaxInputTokens = 1048576;
                selectedConfig.ResponseFormat = "JSON";
                break;
            case "deepseek":
                selectedConfig.ApiEndpoint = "https://api.deepseek.com/v1";
                selectedConfig.ModelName = "deepseek-chat";
                selectedConfig.MaxTokens = 4096;
                selectedConfig.MaxInputTokens = 64000;
                selectedConfig.ResponseFormat = "Text";
                break;
            case "openai":
                selectedConfig.ApiEndpoint = "https://api.openai.com/v1";
                selectedConfig.ModelName = "gpt-4o-mini";
                selectedConfig.MaxTokens = 4096;
                selectedConfig.MaxInputTokens = 128000;
                selectedConfig.ResponseFormat = "JSON";
                break;
            case "ollama":
                selectedConfig.ApiEndpoint = "http://localhost:11434/v1";
                selectedConfig.ModelName = "llama3";
                selectedConfig.MaxTokens = 2048;
                selectedConfig.MaxInputTokens = 8192;
                selectedConfig.ResponseFormat = "Text";
                break;
        }
        statusMessage = $"已加载 {provider} 模板预设，请记得填写通灵密钥 (API Key)。";
        fetchedModels.Clear();
        connectionTestSuccess = null;
        connectionTestResult = null;
    }

    private async Task FetchModelListAsync()
    {
        if (selectedConfig is null) return;

        if (string.IsNullOrWhiteSpace(selectedConfig.ApiEndpoint))
        {
            errorMessage = "请先填写 API URL。";
            return;
        }

        isBusy = true;
        errorMessage = null;
        statusMessage = null;
        fetchedModels.Clear();

        try
        {
            using var client = new HttpClient();
            client.Timeout = TimeSpan.FromSeconds(15);
            var url = selectedConfig.ApiEndpoint.Trim().TrimEnd('/') + "/models";
            using var request = new HttpRequestMessage(HttpMethod.Get, url);
            
            if (!string.IsNullOrWhiteSpace(selectedConfig.ApiKey))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", selectedConfig.ApiKey);
            }

            using var response = await client.SendAsync(request);
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"获取模型列表失败 ({response.StatusCode}): {body}";
                return;
            }

            using var document = JsonDocument.Parse(body);
            if (document.RootElement.TryGetProperty("data", out var dataProp) && dataProp.ValueKind == JsonValueKind.Array)
            {
                var models = new List<string>();
                foreach (var modelItem in dataProp.EnumerateArray())
                {
                    if (modelItem.TryGetProperty("id", out var idProp))
                    {
                        models.Add(idProp.GetString() ?? "");
                    }
                }
                fetchedModels = models.Where(m => !string.IsNullOrEmpty(m)).Distinct().OrderBy(m => m).ToList();
                statusMessage = $"已成功拉取到 {fetchedModels.Count} 个可用模型，可通过下拉框快速选择。";
            }
            else
            {
                errorMessage = "API 返回 Rar JSON 格式不符合 OpenAI /models 规范（未发现 'data' 数组）。";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"拉取模型列表发生异常: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OnFetchedModelSelected(ChangeEventArgs e)
    {
        if (selectedConfig is null) return;
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val))
        {
            selectedConfig.ModelName = val;
        }
    }

    private async Task TestConnectionAsync()
    {
        if (selectedConfig is null) return;
        isTestingConnection = true;
        isBusy = true;
        connectionTestSuccess = null;
        connectionTestResult = null;
        errorMessage = null;

        try
        {
            using var client = new HttpClient();
            client.Timeout = TimeSpan.FromSeconds(20);
            var url = selectedConfig.ApiEndpoint.Trim().TrimEnd('/') + "/chat/completions";
            using var request = new HttpRequestMessage(HttpMethod.Post, url);
            
            if (!string.IsNullOrWhiteSpace(selectedConfig.ApiKey))
            {
                request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", selectedConfig.ApiKey);
            }

            var testPayload = new
            {
                model = selectedConfig.ModelName,
                messages = new[]
                {
                    new { role = "user", content = "hello" }
                },
                max_tokens = 10,
                temperature = 0.5
            };

            request.Content = new StringContent(JsonSerializer.Serialize(testPayload), Encoding.UTF8, "application/json");
            using var response = await client.SendAsync(request);
            var body = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                connectionTestSuccess = true;
                using var doc = JsonDocument.Parse(body);
                var content = string.Empty;
                if (doc.RootElement.TryGetProperty("choices", out var choicesProp) && choicesProp.GetArrayLength() > 0)
                {
                    var msg = choicesProp[0].GetProperty("message");
                    content = msg.TryGetProperty("content", out var cProp) ? cProp.GetString() : "";
                }
                connectionTestResult = $"连接测试成功！\n模型响应内容: \"{content}\"";
            }
            else
            {
                connectionTestSuccess = false;
                connectionTestResult = $"连接失败 (HTTP 错误码 {response.StatusCode}):\n{body}";
            }
        }
        catch (Exception ex)
        {
            connectionTestSuccess = false;
            connectionTestResult = $"通灵网络发生异常: {ex.Message}";
        }
        finally
        {
            isTestingConnection = false;
            isBusy = false;
        }
    }
}
