                                <div style="font-size: 0.8rem; color: var(--color-text-secondary); background: rgba(0,0,0,0.15); padding: 0.35rem; border-radius: 4px; border: 1px solid rgba(207,168,107,0.05); margin-top: 0.25rem;">@locationDescription</div>
                            }
                            <div><span class="attr-label">身份:</span> @protagonistInfo.IdentityText</div>
