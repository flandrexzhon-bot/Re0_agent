                                </label>
                            </div>

                            <!-- 角色与模型绑定 -->
                            <div style="border-top: 1px solid rgba(207,168,107,0.1); padding-top: 0.5rem; margin-top: 0.5rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                                    <span class="text-gold" style="font-weight: bold; font-size: 0.8rem;">角色与模型绑定：</span>
                                    <button type="button" class="btn btn-link text-gold p-0 btn-sm" @onclick="AddCharacterBinding" style="text-decoration: none; font-size: 0.75rem;">＋ 新增</button>
                                </div>
                                @foreach (var b in characterBindings)
                                {
                                    <div style="display: flex; gap: 0.25rem; align-items: center; margin-bottom: 0.25rem;">
                                        <select class="form-select parchment-input" @bind="b.CharacterName" style="flex: 1; font-size: 0.75rem; padding: 0.15rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);">
                                            <option value="">-- 角色 --</option>
                                            @foreach (var name in allCharacterNames)
                                            {
                                                <option value="@name">@name</option>
                                            }
                                        </select>
                                        <span style="color: var(--color-gold);">➔</span>
                                        <select class="form-select parchment-input" @bind="b.PresetName" style="flex: 1.2; font-size: 0.75rem; padding: 0.15rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);">
                                            <option value="">-- 模型 --</option>
                                            @foreach (var p in agentConfigs)
                                            {
                                                <option value="@p.AgentName">@p.AgentName</option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-sm btn-outline-danger p-0" style="width: 18px; height: 18px; line-height: 16px; border: 1px solid var(--color-crimson); color: var(--color-crimson); background: transparent; cursor: pointer;" @onclick="() => RemoveCharacterBinding(b)">×</button>
                                    </div>
                                }
                            </div>

                            <!-- 临时 NPC 绑定 -->
                            <div style="border-top: 1px solid rgba(207,168,107,0.1); padding-top: 0.5rem; margin-top: 0.5rem;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                                    <span class="text-gold" style="font-weight: bold; font-size: 0.8rem;">临时 NPC 绑定：</span>
                                    <button type="button" class="btn btn-link text-gold p-0 btn-sm" @onclick="AddTempNpcBinding" style="text-decoration: none; font-size: 0.75rem;">＋ 新增</button>
                                </div>
                                @foreach (var b in tempNpcBindings)
                                {
                                    <div style="display: flex; gap: 0.25rem; align-items: center; margin-bottom: 0.25rem;">
                                        <input type="text" class="form-control parchment-input" placeholder="NPC 姓名" @bind="b.NpcName" style="flex: 1; font-size: 0.75rem; padding: 0.15rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);" />
                                        <span style="color: var(--color-gold);">➔</span>
                                        <select class="form-select parchment-input" @bind="b.PresetName" style="flex: 1.2; font-size: 0.75rem; padding: 0.15rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);">
                                            <option value="">-- 模型 --</option>
                                            @foreach (var p in agentConfigs)
                                            {
                                                <option value="@p.AgentName">@p.AgentName</option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-sm btn-outline-danger p-0" style="width: 18px; height: 18px; line-height: 16px; border: 1px solid var(--color-crimson); color: var(--color-crimson); background: transparent; cursor: pointer;" @onclick="() => RemoveTempNpcBinding(b)">×</button>
                                    </div>
                                }
                            </div>

                            <button type="button" class="primary-action" style="width: 100%; font-size: 0.8rem; margin: 0.5rem 0 0 0; padding: 0.35rem;" @onclick="SaveRoutingConfigAsync">
                                保存配置契约
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-gold">
                        ⚠️ 暂无主角属性，请在左侧应用模板，或在上方新建聊天会话。
                    </div>
                }
            </div>
        }
        else
        {
            <div class="sidebar-collapsed-content" style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem; color: var(--color-gold); opacity: 0.8; font-family: var(--font-heading); writing-mode: vertical-rl; text-orientation: mixed; letter-spacing: 4px; font-size: 0.95rem;">
                🛡️ 冒险者状态栏
            </div>
        }
    </div>
    </div>
}
<!--MODALS_PLACEHOLDER-->
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 1001; display: flex; align-items: center; justify-content: center;">
        <div class="work-surface error-panel" style="max-width: 500px; padding: 1.5rem; border-color: var(--color-crimson);">
            <h2 style="color: var(--color-crimson-glow); display: flex; align-items: center; gap: 0.5rem;">⚠️ 魔力失控 (错误)</h2>
            <p style="margin-top: 1rem; line-height: 1.5; color: var(--color-text-primary);">@errorMessage</p>
            <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid rgba(166, 36, 36, 0.3); padding-top: 1rem;">
                <button type="button" class="btn-custom danger-action" @onclick="() => errorMessage = null">确认</button>
            </div>
        </div>
    </div>
}




@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    private string playerInput = string.Empty;
    private bool skipPlayerTurn;
    private bool directPlayerOutput = true;
    private string? errorMessage;


    private Re0Agent.Core.Models.RoundPhase phase = Re0Agent.Core.Models.RoundPhase.Idle;
    private bool isBusy;
    private GameRound? activeRound;
    private readonly List<GameRound> sessionRounds = new();

    private List<ChatSession> chatSessions = new();
    private int activeSessionId;
    private string newSessionName = string.Empty;

    private int currentChapter = 1;
    private int loopCount = 0;
    private int miasmaLevel = 0;
    private bool showDeathGlitch = false;
    private bool hasProtagonist = false;
    private List<ChronicleEntry> chronicles = new();
    private IReadOnlyList<ProtagonistTemplate> templates = new List<ProtagonistTemplate>();

    private bool sidebarExpanded = true;

    private ProtagonistInfo? protagonistInfo;
    private List<InventoryItem> inventories = new();
    private List<EquipmentItem> equipments = new();
    private string? locationDescription;
    private string? locationRegion;

    // Model configuration parameters
    private List<ImportantNpc> allNpcs = new();
    private List<Quest> quests = new();
    private List<string> allCharacterNames = new();
    private List<Re0Agent.Core.Entities.AgentConfig> agentConfigs = new();

    private string selectedGmPreset = string.Empty;
    private string selectedNpcPreset = string.Empty;
    private string selectedDicePreset = string.Empty;
    private string selectedMemoryPreset = string.Empty;
    private string selectedCharacterSubPreset = string.Empty;
    private string selectedChapterSwitchPreset = string.Empty;
    private double delaySeconds = 0.0;
    private bool autoRetryEnabled = true;
    private bool streamingEnabled = false;

    private List<GameProgressService.CharacterBinding> characterBindings = new();
    private List<GameProgressService.TempNpcBinding> tempNpcBindings = new();

    private void AddCharacterBinding()
    {
        Progress.AddCharacterBinding();
    }

    private void RemoveCharacterBinding(GameProgressService.CharacterBinding b)
    {
        Progress.RemoveCharacterBinding(b);
    }

    private void AddTempNpcBinding()
    {
        Progress.AddTempNpcBinding();
    }

    private void RemoveTempNpcBinding(GameProgressService.TempNpcBinding b)
    {
        Progress.RemoveTempNpcBinding(b);
    }

    // ── 重 roll / 变体切换 / fork ──
    private async Task ReRoll(int fromTurnIndex, bool regenerateOpening)
    {
        await Progress.ReRollAsync(fromTurnIndex, regenerateOpening);
    }

    private async Task SelectVariant(int index)
    {
        await Progress.SelectVariant(index);
    }

    private async Task ForkAt(GameRound round)
    {
        await Progress.ForkAtAsync(round);
    }

    protected override async Task OnInitializedAsync()
    {
        Progress.OnStateChanged += SyncState;
        if (!Progress.IsBusy)
        {
            await Progress.LoadDatabaseStateAsync();
        }
        SyncState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 切回主页面时编年史容器首次渲染后自动滚到底部，定位到最新内容方便玩家操作。
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("scrollElementToBottom", "grimoireLogScroll"); }
            catch { /* JS 尚未就绪时忽略 */ }
        }
    }

    public void Dispose()
    {
        Progress.OnStateChanged -= SyncState;
    }

    private void SyncState()
    {
        InvokeAsync(() =>
        {
            phase = Progress.Phase;
            isBusy = Progress.IsBusy;
            activeRound = Progress.ActiveRound;
            
            sessionRounds.Clear();
            lock (Progress.SessionRounds)
            {
                sessionRounds.AddRange(Progress.SessionRounds);
            }
            
            chatSessions = Progress.ChatSessions;
            activeSessionId = Progress.ActiveSessionId;
            playerInput = Progress.GetPlayerInputDraft(Progress.ActiveSessionId);
            currentChapter = Progress.CurrentChapter;
            loopCount = Progress.LoopCount;
            miasmaLevel = Progress.MiasmaLevel;
            showDeathGlitch = Progress.ShowDeathGlitch;
            hasProtagonist = Progress.HasProtagonist;
            chronicles = Progress.Chronicles;
            templates = Progress.Templates;
            protagonistInfo = Progress.Protagonist;
            
            inventories.Clear();
            inventories.AddRange(Progress.Inventories);
            
