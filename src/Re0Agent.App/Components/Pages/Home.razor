@page "/"
@using Microsoft.EntityFrameworkCore
@using Re0Agent.Core.Models
@using Re0Agent.Core.Services.Agent
@using Re0Agent.Core.Entities
@using Re0Agent.Core.Database
@using Re0Agent.Core.Services.Database
@inject AgentOrchestrator Orchestrator
@inject Re0AgentDbContext DbContext
@inject ProtagonistTemplateService TemplateService

<PageTitle>命运之卷 - Re:Zero RPG</PageTitle>

<!-- 死亡回归 Glitch 动画遮罩 -->
<div class="death-glitch-overlay @(showDeathGlitch ? "active" : "")">
    <div class="death-glitch-text">死 亡 回 归</div>
</div>

<!-- 魔女叹息紫色滤镜 -->
@if (miasmaLevel > 0)
{
    <div class="miasma-fog-layer" style="opacity: @(((double)miasmaLevel / 150.0).ToString(System.Globalization.CultureInfo.InvariantCulture));"></div>
}

<div class="fate-book fate-book--novel">
    <!-- 顶部状态面板 -->
    <div class="novel-header-bar">
        <div class="novel-header-badge chapter">章节 @currentChapter</div>
        <div class="miasma-container">
            <span class="miasma-label">瘴气: @miasmaLevel%</span>
            <div class="miasma-bar-bg">
                <div class="miasma-bar-fill" style="width: @(miasmaLevel)%"></div>
            </div>
        </div>
        @if (loopCount > 0)
        {
            <div class="novel-header-badge loop-badge">LOOP @loopCount</div>
        }
    </div>

    <!-- 命运之卷编年史日志 -->
    <section class="work-surface grimoire-log" id="grimoireLogScroll">
        <h2>编年史 / 命运之卷</h2>

        <!-- 跨 session 持久历史纪要 -->
        @foreach (var entry in chronicles)
        {
            <div class="grimoire-entry gm-narrative">
                <div class="entry-header"><span>@entry.CodeIndex (@entry.TimeSpan)</span></div>
                <div class="entry-body">@entry.ChronicleText</div>
            </div>
        }

        <!-- 本次会话内已进行/进行中的回合（保留气泡与检定卡片） -->
        @foreach (var round in sessionRounds)
        {
            <div class="system-event-log">─── 命运分歧点：@round.RoundIndex ───</div>

            @if (!string.IsNullOrWhiteSpace(round.GmOpening))
            {
                <div class="grimoire-entry gm-narrative">
                    <div class="entry-header"><span>GM 引入叙事</span></div>
                    <div class="entry-body">@round.GmOpening</div>
                </div>
            }

            @foreach (var turn in round.CharacterTurns)
            {
                <div class="grimoire-entry">
                    <div class="character-speech-bubble @(turn.IsPlayerControlled ? "player-bubble" : "npc-bubble")">
                        <div class="bubble-avatar">@turn.CharacterName.Substring(0, 1)</div>
                        <div class="bubble-content">
                            <span class="bubble-sender">@turn.CharacterName</span>
                            <div class="bubble-text">@turn.ActionText</div>
                            @if (!turn.Skipped && turn.DiceResult is not null)
                            {
                                <div class="bubble-details">
                                    @if (!string.IsNullOrWhiteSpace(turn.GmJudgement))
                                    {
                                        <div class="bubble-judgement">GM 行为判定: @turn.GmJudgement</div>
                                    }
                                    <div class="dice-result-card @GetDiceSuccessClass(turn.DiceResult.SuccessLevel)">
                                        <span class="dice-icon">🎲</span>
                                        <span>@FormatDiceResult(turn.DiceResult)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(turn.ResultResponse))
                                    {
                                        <div class="bubble-text" style="margin-top: 0.35rem; font-style: italic; color: var(--color-text-secondary);">@turn.ResultResponse</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(round.GmSummary))
            {
                <div class="grimoire-entry gm-narrative">
                    <div class="entry-header"><span>GM 回合总结</span></div>
                    <div class="entry-body">@round.GmSummary</div>
                </div>
            }

            @foreach (var systemMsg in round.Events.Where(e => e.StartsWith("填表Agent") || e.StartsWith("自动存档") || e.StartsWith("死亡回归")))
            {
                <div class="system-event-log">🔮 @systemMsg</div>
            }
        }

        @if (phase == RoundPhase.NpcRunning)
        {
            <div class="grimoire-entry gm-narrative" style="opacity: 0.85;">
                <div class="entry-header"><span>群像演绎中...</span></div>
                <div class="entry-body" style="font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
                    <div class="spinner-border text-warning" role="status" style="width: 1.25rem; height: 1.25rem; border-width: 2px;"></div>
                    <span>在场角色正在行动，请稍候...</span>
                </div>
            </div>
        }
        else if (phase == RoundPhase.Finalizing)
        {
            <div class="grimoire-entry gm-narrative" style="opacity: 0.85;">
                <div class="entry-header"><span>魔力交织中...</span></div>
                <div class="entry-body" style="font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
                    <div class="spinner-border text-warning" role="status" style="width: 1.25rem; height: 1.25rem; border-width: 2px;"></div>
                    <span>GM 正在编织世界线并刻入编年史...</span>
                </div>
            </div>
        }
    </section>
    <!--CONSOLE_PLACEHOLDER-->
    <section class="work-surface round-console-surface">
        @if (!hasProtagonist)
        {
            <h2>缔造命运的主角</h2>
            <p style="color: var(--color-text-secondary); margin-bottom: 1rem;">
                当前世界线尚未铭刻主角。请先选择一个主角模板，开启起始于零的异世界旅程。
            </p>
            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                @foreach (var tpl in templates)
                {
                    <button class="btn-custom @(tpl.IsDefault == 1 ? "primary-action" : "")" type="button"
                            disabled="@isBusy" @onclick="() => ApplyTemplateAsync(tpl.TemplateId)">
                        @(tpl.IsDefault == 1 ? "★ " : "")@tpl.TemplateName
                    </button>
                }
            </div>
        }
        else if (phase == RoundPhase.AwaitingPlayer)
        {
            <h2>书写主角的抉择</h2>
            <div class="round-console">
                <textarea @bind="playerInput" rows="3"
                          placeholder="@(skipPlayerTurn ? "旁观模式：主角将保持沉默。" : "在此书写主角的动作、语言或决策...")"></textarea>
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem;">
                    <label class="inline-toggle">
                        <input type="checkbox" @bind="skipPlayerTurn" />
                        <span>旁观模式（跳过主角本回合行动）</span>
                    </label>
                    <button class="primary-action" type="button" disabled="@isBusy" @onclick="SubmitPlayerTurnAsync">
                        @(isBusy ? "命运编制中..." : "落笔 (提交主角行动)")
                    </button>
                </div>
            </div>
        }
        else
        {
            <h2>纺织新的命运线</h2>
            <p style="color: var(--color-text-secondary); margin-bottom: 1rem;">
                点击「开始大回合」，GM 将铺陈场景、在场角色依次行动；待群像落定后，再轮到你书写主角的抉择。
            </p>
            <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                <button class="danger-action" type="button" disabled="@isBusy" @onclick="() => showConfirmResetModal = true">
                    🔄 重开世界
                </button>
                <button class="primary-action" type="button" disabled="@isBusy" @onclick="BeginRoundAsync">
                    @(phase == RoundPhase.NpcRunning ? "角色行动中..." : "▶ 开始大回合")
                </button>
            </div>
        }
    </section>

</div>
<!--MODALS_PLACEHOLDER-->
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 1001; display: flex; align-items: center; justify-content: center;">
        <div class="work-surface error-panel" style="max-width: 500px; padding: 1.5rem; border-color: var(--color-crimson);">
            <h2 style="color: var(--color-crimson-glow); display: flex; align-items: center; gap: 0.5rem;">⚠️ 魔力失控 (错误)</h2>
            <p style="margin-top: 1rem; line-height: 1.5; color: var(--color-text-primary);">@errorMessage</p>
            <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem; border-top: 1px solid rgba(166, 36, 36, 0.3); padding-top: 1rem;">
                <button type="button" class="btn-custom danger-action" @onclick="() => errorMessage = null">确认</button>
            </div>
        </div>
    </div>
}

@if (showConfirmResetModal)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); z-index: 1000; display: flex; align-items: center; justify-content: center;">
        <div class="work-surface" style="max-width: 450px; border-color: var(--color-crimson);">
            <h2 style="color: var(--color-crimson-glow);">⚠️ 命运重置确认</h2>
            <p style="margin-top: 1rem; line-height: 1.5;">确定要毁灭当前世界线并进行“命运重开”吗？</p>
            <p style="color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.5;">
                警告：此操作将清空当前所有章节进度、编年史、人物关系、物品装备和死亡回归日志（重置循环次数为0）。您的 Agent API 契约配置将被保留。此操作不可逆！
            </p>
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem; border-top: 1px solid rgba(84, 56, 44, 0.4); padding-top: 1rem;">
                <button type="button" class="btn-custom" @onclick="() => showConfirmResetModal = false">继续当前线</button>
                <button type="button" class="danger-action" @onclick="ResetGameAsync">重置世界</button>
            </div>
        </div>
    </div>
}


@code {
    private enum RoundPhase { Idle, NpcRunning, AwaitingPlayer, Finalizing }

    private string playerInput = string.Empty;
    private bool skipPlayerTurn;
    private string? errorMessage;

    private RoundPhase phase = RoundPhase.Idle;
    private bool isBusy;
    private GameRound? activeRound;
    private readonly List<GameRound> sessionRounds = new();

    private int currentChapter = 1;
    private int loopCount = 0;
    private int miasmaLevel = 0;
    private bool showDeathGlitch = false;
    private bool showConfirmResetModal = false;
    private bool hasProtagonist = false;
    private List<ChronicleEntry> chronicles = new();
    private IReadOnlyList<ProtagonistTemplate> templates = new List<ProtagonistTemplate>();

    protected override async Task OnInitializedAsync()
    {
        await LoadDatabaseStateAsync();
    }

    private async Task BeginRoundAsync()
    {
        isBusy = true;
        phase = RoundPhase.NpcRunning;
        errorMessage = null;
        try
        {
            var round = await Orchestrator.BeginRoundAsync();
            activeRound = round;
            sessionRounds.Add(round);

            if (round.DeathReturnTriggered)
            {
                await HandleRoundCompletionAsync(round);
                return;
            }

            phase = RoundPhase.AwaitingPlayer;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            RollbackActiveRound();
            phase = RoundPhase.Idle;
        }
        finally
        {
            isBusy = false;
        }
    }
//CODE_PLACEHOLDER

    private async Task SubmitPlayerTurnAsync()
    {
        if (activeRound is null)
        {
            phase = RoundPhase.Idle;
            return;
        }

        isBusy = true;
        phase = RoundPhase.Finalizing;
        errorMessage = null;
        try
        {
            var round = await Orchestrator.CompletePlayerTurnAsync(activeRound, playerInput, skipPlayerTurn);
            await HandleRoundCompletionAsync(round);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            phase = RoundPhase.AwaitingPlayer;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleRoundCompletionAsync(GameRound round)
    {
        if (round.DeathReturnTriggered)
        {
            showDeathGlitch = true;
            StateHasChanged();
            await Task.Delay(1800);
            showDeathGlitch = false;
        }

        playerInput = string.Empty;
        activeRound = null;
        phase = RoundPhase.Idle;
        await LoadDatabaseStateAsync();
    }

    private void RollbackActiveRound()
    {
        if (activeRound is not null)
        {
            sessionRounds.Remove(activeRound);
            activeRound = null;
        }
    }
//CODE_PLACEHOLDER2

    private async Task ApplyTemplateAsync(int templateId)
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            await TemplateService.ApplyTemplateAsync(templateId);
            sessionRounds.Clear();
            activeRound = null;
            phase = RoundPhase.Idle;
            await LoadDatabaseStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"应用主角模板失败: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ResetGameAsync()
    {
        showConfirmResetModal = false;
        isBusy = true;
        errorMessage = null;
        try
        {
            await TemplateService.ResetGameAsync();
            sessionRounds.Clear();
            activeRound = null;
            phase = RoundPhase.Idle;
            playerInput = string.Empty;
            await LoadDatabaseStateAsync();

            showDeathGlitch = true;
            StateHasChanged();
            await Task.Delay(1000);
            showDeathGlitch = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"重置世界线失败: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
//CODE_PLACEHOLDER3

    private async Task LoadDatabaseStateAsync()
    {
        try
        {
            var state = await DbContext.GlobalStates.AsNoTracking().FirstOrDefaultAsync();
            currentChapter = state?.CurrentChapter ?? 1;

            hasProtagonist = await DbContext.ProtagonistInfo.AsNoTracking().AnyAsync();
            templates = await TemplateService.ListTemplatesAsync();

            var latestLog = await DbContext.DeathReturnLog.AsNoTracking()
                .OrderByDescending(item => item.LogId)
                .FirstOrDefaultAsync();
            loopCount = latestLog?.LoopCount ?? 0;
            miasmaLevel = latestLog?.MiasmaLevel ?? 0;

            chronicles = await DbContext.Chronicle.AsNoTracking()
                .OrderBy(c => c.RowId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"加载状态错误: {ex.Message}";
        }
    }

    private string GetDiceSuccessClass(string? successLevel)
    {
        if (string.IsNullOrWhiteSpace(successLevel)) return "";
        var sl = successLevel.ToLower();
        if (sl.Contains("大成功") || sl.Contains("极难成功") || sl.Contains("困难成功") || sl.Contains("成功"))
        {
            return "success-level-great";
        }
        if (sl.Contains("大失败") || sl.Contains("失败"))
        {
            return "success-level-fail";
        }
        return "";
    }

    private string FormatDiceResult(DiceResult? result)
    {
        if (result is null) return "未执行";
        var rollText = result.Roll is null
            ? string.Empty
            : $"，骰值{result.Roll}/{result.TargetAfterModifiers ?? result.Target}";
        var detail = string.IsNullOrWhiteSpace(result.Detail) ? string.Empty : $"，{result.Detail}";
        return $"{result.Command} => {result.Outcome}/{result.SuccessLevel}{rollText}{detail}";
    }
}
