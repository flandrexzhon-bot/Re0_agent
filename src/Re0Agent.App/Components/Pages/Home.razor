@page "/"
@using Microsoft.EntityFrameworkCore
@using Re0Agent.Core.Models
@using Re0Agent.Core.Services.Agent
@using Re0Agent.Core.Entities
@using Re0Agent.Core.Database
@using Re0Agent.Core.Services.Database
@using System.Text.Json
@using System.Diagnostics
@inject AgentOrchestrator Orchestrator
@inject Re0AgentDbContext DbContext
@inject ChatSessionService SessionService
@inject WorldClockService WorldClock
@inject WorldTickGovernor TickGovernor
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>命运长卷 - Re:Zero 连续世界</PageTitle>

<div class="world-shell @(IsTheater ? "mode-theater" : "mode-rp")">

    <!-- ══ 世界状态条 ══ -->
    <header class="world-bar">
        <div class="world-bar-left">
            <span class="world-sigil">@(IsTheater ? "❖" : "✧")</span>
            <div class="world-bar-title">
                <span class="world-name">命运长卷</span>
                <span class="world-mode @(IsTheater ? "tag-theater" : "tag-rp")">
                    @(IsTheater ? "剧场模式 · 全知观看" : "RP 模式 · 主角视角")
                    <span class="mode-lock" title="模式在会话创建时锁定，无法更改">锁定</span>
                </span>
            </div>
        </div>

        <div class="world-bar-clock">
            <div class="clock-face">
                <span class="clock-label">世界时刻</span>
                <span class="clock-value">@WorldClockText</span>
            </div>
            <div class="clock-rate @(IsPaused ? "rate-halted" : "") @(IsInputSlowed ? "rate-slowed" : "")">
                <span>×@EffectiveScaleText</span>
                @if (IsInputSlowed)
                {
                    @* 慢动作是你按键换来的，不是设置失效：说清楚它作用在整个世界上。 *@
                    <span class="rate-note" title="你正在组织输入，当前场景与离屏世界同步进入慢动作">输入慢动作 ×@InputSlowFactorText</span>
                }
                @if (BackpressureFactor < 0.999)
                {
                    <span class="rate-note" title="前台生成积压导致的系统背压，不是你的设置被忽略">背压 ×@BackpressureFactor.ToString("0.00")</span>
                }
            </div>
        </div>

        <div class="world-bar-right">
            <div class="session-picker">
                <select class="session-select" @bind="selectedSessionId" @bind:after="SwitchSessionAsync" disabled="@isSwitching">
                    @foreach (var s in sessions)
                    {
                        <option value="@s.SessionId">@(s.IsActive == 1 ? "▸ " : "")@s.SessionName · @(s.GameMode == "Theater" ? "剧场" : "RP")</option>
                    }
                </select>
                <button type="button" class="ghost-btn" title="新建会话（可选择游戏模式）" @onclick="OpenNewSessionDialog">＋ 新会话</button>
            </div>
            <button type="button" class="pause-btn @(IsPaused ? "resumed" : "running")" disabled="@(isTogglingPause || activeSession is null)" @onclick="TogglePauseAsync">
                @if (IsPaused)
                {
                    <span>▶ 恢复世界</span>
                }
                else
                {
                    <span>⏸ 暂停世界</span>
                }
            </button>
        </div>
    </header>

    @if (IsPaused)
    {
        <div class="halt-ribbon">世界已暂停 · 逻辑时间停止推进，不再调度事件或发起新的生成</div>
    }

    @if (!string.IsNullOrWhiteSpace(tickError))
    {
        <div class="tick-ribbon" role="status">
            <span>世界推进遇到问题：@tickError</span>
            <span class="tick-note">节拍仍在继续，下一拍会重试。</span>
        </div>
    }

    <div class="world-body">

        <!-- ══ 连续事件长卷 ══ -->
        <main class="timeline-column">
            <div class="timeline-head">
                <h2>事件长卷</h2>
                <div class="timeline-head-tools">
                    @if (CanShowWorldLog)
                    {
                        <span class="event-count">@VisibleCount 条已呈现 / 共 @timeline.Count</span>
                        <label class="switch-inline" title="显示导演计划、行动机会、状态提交等世界内部事件">
                            <input type="checkbox" @bind="showWorldLog" @bind:after="RebuildVisibleEvents" />
                            <span>世界内部层</span>
                        </label>
                    }
                    else
                    {
                        @* RP 模式只报你亲历的条数：任何离屏总量都不出现在界面上。 *@
                        <span class="event-count">@VisibleCount 段亲历</span>
                    }
                </div>
            </div>

            <div class="timeline-scroll" id="timelineScroll">
                <div class="timeline-spine"></div>

                @if (VisibleCount == 0)
                {
                    <div class="timeline-empty">
                        <div class="empty-mark">∅</div>
                        <p>@(IsTheater ? "这条世界线还没有任何已提交事件。" : "你还没有亲历任何事情。")</p>
                        <p class="empty-hint">
                            @(IsTheater
                                ? "写下第一条导演指令，双导演会把它转化为世界中可实现的铺垫。"
                                : "写下主角的第一个动作，世界会从那一刻开始自行运转。")
                        </p>
                    </div>
                }

                @foreach (var (item, ordinal) in VisibleWithOrdinal)
                {
                    var visual = Describe(item);
                    <article class="event-node kind-@visual.Kind">
                        <div class="node-dot" aria-hidden="true">@visual.Icon</div>
                        <div class="node-card">
                            <div class="node-meta">
                                <span class="node-actor">@visual.Label</span>
                                @if (!string.IsNullOrWhiteSpace(item.SceneId))
                                {
                                    <span class="node-scene">@item.SceneId</span>
                                }
                                <span class="node-time">@ShortWorldTime(item.WorldTime)</span>
                                @if (item.Status == "Interrupted")
                                {
                                    <span class="node-flag flag-interrupted" title="被玩家插话打断，只有已显示的部分是事实">被打断</span>
                                }
                                @if (item.WorldEpoch != CurrentEpoch)
                                {
                                    <span class="node-flag flag-epoch" title="属于被回滚的世界纪元">纪元 @item.WorldEpoch</span>
                                }
                                @* 剧场模式显示真实 sequence；RP 模式只显示本地连续编号，
                                   否则序号断层会暴露有多少离屏事件被隐藏。 *@
                                <span class="node-seq">#@(IsTheater ? item.Sequence?.ToString() ?? "-" : ordinal.ToString())</span>
                            </div>
                            <div class="node-body">@((MarkupString)RenderContent(item))</div>
                        </div>
                    </article>
                }
            </div>

            <!-- ══ 输入 ══ -->
            <div class="composer @(IsTheater ? "composer-theater" : "composer-rp")">
                <div class="composer-label">
                    @if (IsTheater)
                    {
                        <span>写给双导演的创作指令</span>
                        <span class="composer-hint">不是主角台词。指令会作为隐藏 PlayerDirection 保存，场内角色看不到它。</span>
                    }
                    else
                    {
                        <span>主角的行动与话语</span>
                        <span class="composer-hint">世界不会等你。沉默时其他角色仍会按自己的目标行动。</span>
                    }
                </div>
                <div class="composer-row">
                    @* 键盘活动即输入活动：每次击键都刷新活动信号，让核心把整个世界放慢。
                       草稿文本本身只留在界面上，不作为任何事实或提示词。 *@
                    <textarea class="composer-input" rows="3" @bind="playerInput" @bind:event="oninput"
                              @bind:after="OnComposerInputAsync"
                              @onkeydown="OnComposerKeyDownAsync"
                              @onblur="OnComposerBlurAsync"
                              placeholder="@(IsTheater ? "例如：让拉姆在下一次合适的时机主动提起宅邸的异常……" : "例如：我把手伸进口袋，慢慢退向巷口。")"
                              disabled="@(isSubmitting || activeSession is null)"></textarea>
                    <button type="button" class="send-btn" disabled="@(isSubmitting || string.IsNullOrWhiteSpace(playerInput) || activeSession is null)" @onclick="SubmitAsync">
                        @if (isSubmitting)
                        {
                            <span class="send-spin"></span><span>提交中</span>
                        }
                        else
                        {
                            <span>@(IsTheater ? "递交指令" : "落笔")</span>
                        }
                    </button>
                </div>
            </div>
        </main>

        <!-- ══ 世界与角色面板 ══ -->
        <aside class="world-aside @(asideOpen ? "open" : "closed")">
            <button type="button" class="aside-toggle" @onclick="() => asideOpen = !asideOpen">
                @(asideOpen ? "收起 ▸" : "◂ 世界")
            </button>

            @if (asideOpen)
            {
                <div class="aside-scroll">
                    <section class="aside-block">
                        <h3>此刻的世界</h3>
                        @if (globalState is not null)
                        {
                            @* RP 模式锚定主角所在；剧场模式才显示镜头当前所在场景。 *@
                            <div class="kv"><span>@(IsTheater ? "镜头" : "你所在")</span><b>@ViewpointSceneLabel</b></div>
                            <div class="kv"><span>区域</span><b>@globalState.CurrentMinorRegion · @globalState.CurrentMajorRegion</b></div>
                            <div class="kv"><span>世界内时间</span><b>@globalState.CurTime</b></div>
                            <div class="kv"><span>章节标签</span><b class="soft-tag" title="章节只是软叙事标签，不覆盖已提交事实">第 @globalState.CurrentChapter 章</b></div>
                        }
                        else
                        {
                            <p class="aside-empty">世界投影尚未建立。</p>
                        }
                        @if (loopCount > 0)
                        {
                            <div class="kv"><span>回归次数</span><b class="loop-count">LOOP @loopCount</b></div>
                        }
                    </section>

                    <section class="aside-block">
                        <h3>在场角色 <span class="count">@presentCast.Count</span></h3>
                        @if (presentCast.Count == 0)
                        {
                            <p class="aside-empty">当前场景没有已登记的角色。</p>
                        }
                        else
                        {
                            <div class="cast-list">
                                @foreach (var member in presentCast)
                                {
                                    <div class="cast-card @(member.IsViewpoint ? "viewpoint" : "")">
                                        <div class="cast-avatar">@member.Name.Substring(0, 1)</div>
                                        <div class="cast-text">
                                            <div class="cast-name">
                                                @member.Name
                                                @if (member.IsViewpoint)
                                                {
                                                    <span class="cast-badge">@(IsTheater ? "有自主 Agent" : "由你操作")</span>
                                                }
                                            </div>
                                            <div class="cast-note">@member.Note</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </section>

                    @if (protagonist is not null)
                    {
                        <section class="aside-block">
                            <h3>@protagonist.Name</h3>
                            <div class="bars">
                                <div class="bar-row">
                                    <span class="bar-name">生命</span>
                                    <div class="bar-track"><div class="bar-fill fill-hp" style="width: @Pct(protagonist.Hp, protagonist.MaxHp)%;"></div></div>
                                    <span class="bar-num">@protagonist.Hp/@protagonist.MaxHp</span>
                                </div>
                                <div class="bar-row">
                                    <span class="bar-name">魔力</span>
                                    <div class="bar-track"><div class="bar-fill fill-mp" style="width: @Pct(protagonist.Mp, protagonist.MaxMp)%;"></div></div>
                                    <span class="bar-num">@protagonist.Mp/@protagonist.MaxMp</span>
                                </div>
                                <div class="bar-row">
                                    <span class="bar-name">体力</span>
                                    <div class="bar-track"><div class="bar-fill fill-sp" style="width: @Pct(protagonist.Stamina, protagonist.MaxStamina)%;"></div></div>
                                    <span class="bar-num">@protagonist.Stamina/@protagonist.MaxStamina</span>
                                </div>
                            </div>
                            <div class="kv"><span>状态</span><b>@protagonist.SelfStatus</b></div>
                            <div class="kv"><span>所在</span><b>@protagonist.LocationName</b></div>
                            <div class="attr-row">
                                @foreach (var attr in ParseAttributes(protagonist.BaseAttributes))
                                {
                                    <span class="attr-chip"><i>@attr.Key</i>@attr.Value</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(protagonist.SpecialAttributes))
                            {
                                <div class="kv"><span>权能</span><b class="special">@protagonist.SpecialAttributes</b></div>
                            }
                        </section>

                        <details class="aside-fold">
                            <summary>技能 <span class="count">@skills.Count</span></summary>
                            @if (skills.Count == 0)
                            {
                                <p class="aside-empty">暂无技能。</p>
                            }
                            else
                            {
                                <div class="chip-wrap">
                                    @foreach (var skill in skills)
                                    {
                                        <span class="chip @(skill.Available ? "" : "chip-off")" title="@skill.Description">@skill.Name</span>
                                    }
                                </div>
                            }
                        </details>

                        <details class="aside-fold">
                            <summary>随身 <span class="count">@inventories.Count</span></summary>
                            @if (inventories.Count == 0)
                            {
                                <p class="aside-empty">空无一物。</p>
                            }
                            else
                            {
                                <div class="chip-wrap">
                                    @foreach (var item in inventories)
                                    {
                                        <span class="chip" title="@item.Description">@item.ItemName ×@item.Quantity</span>
                                    }
                                </div>
                            }
                        </details>

                        <details class="aside-fold">
                            <summary>任务 <span class="count">@quests.Count</span></summary>
                            @if (quests.Count == 0)
                            {
                                <p class="aside-empty">没有进行中的委派。</p>
                            }
                            else
                            {
                                <div class="quest-list">
                                    @foreach (var quest in quests)
                                    {
                                        <div class="quest-item">
                                            <div class="quest-top"><b>@quest.QuestName</b><span>@quest.StatusTag</span></div>
                                            <div class="quest-desc">@quest.TargetDesc</div>
                                            <div class="quest-progress">@quest.ProgressText</div>
                                        </div>
                                    }
                                </div>
                            }
                        </details>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@if (showNewSessionDialog)
{
    <div class="modal-veil" @onclick="CloseNewSessionDialog">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2>开启新的世界线</h2>
            <p class="modal-lead">游戏模式在创建时确定并永久锁定。想换模式，只能新建会话。</p>

            <label class="field-label">会话名称</label>
            <input type="text" class="field-input" placeholder="例如：王都的第一日" @bind="newSessionName" />

            <label class="field-label">游戏模式</label>
            <div class="mode-choices">
                <button type="button" class="mode-choice @(newSessionMode == "RP" ? "picked" : "")" @onclick="@(() => newSessionMode = "RP")">
                    <span class="choice-title">RP 模式</span>
                    <span class="choice-desc">你只操作主角。系统绝不替主角说话或行动，离屏世界照常运转，但只能通过目击、传闻、调查得知。</span>
                </button>
                <button type="button" class="mode-choice @(newSessionMode == "Theater" ? "picked" : "")" @onclick="@(() => newSessionMode = "Theater")">
                    <span class="choice-title">剧场模式</span>
                    <span class="choice-desc">主角也有自主 Agent。你的输入是给双导演的创作指令，并获得全知观看视角与离屏镜头。</span>
                </button>
            </div>

            <div class="modal-actions">
                <button type="button" class="ghost-btn" @onclick="CloseNewSessionDialog">取消</button>
                <button type="button" class="send-btn" disabled="@(isCreating || string.IsNullOrWhiteSpace(newSessionName))" @onclick="CreateSessionAsync">
                    @(isCreating ? "创建中…" : "创建并进入")
                </button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="modal-veil">
        <div class="modal-card error">
            <h2>魔力失控</h2>
            <p class="error-text">@errorMessage</p>
            <div class="modal-actions">
                <button type="button" class="send-btn" @onclick="() => errorMessage = null">确认</button>
            </div>
        </div>
    </div>
}

@code {
    // 前台事件：两种模式都可以出现在长卷上的类型。
    private static readonly string[] ForegroundTypes =
    [
        "PlayerInput", "CharacterAction", "KeplerNarration", "ImportedGreeting",
        "RuleResolution", "WorldRewindCommitted", "RuntimeControl"
    ];

    // RP 模式下不需要目击者即可显示的类型：它们是玩家自己的操作或系统告知，
    // 不携带任何离屏世界事实。其余类型必须通过主角目击判定。
    private static readonly string[] PlayerFacingTypes =
    [
        "PlayerInput", "RuntimeControl", "WorldRewindCommitted", "ImportedGreeting"
    ];

    private static readonly TimeSpan TickInterval = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan MaxTickElapsed = TimeSpan.FromSeconds(30);

    // 输入慢动作倍率：必须大于 0 且不超过 1，核心会校验。
    // 它同步作用于当前场景与离屏世界，不是界面动画速度。确切数值属于待校准的实验参数。
    private const double InputSlowFactorValue = 0.25;

    // 键盘静默多久算"停止输入"。草稿非空时不会因为静默而恢复原速。
    private static readonly TimeSpan InputIdleTimeout = TimeSpan.FromSeconds(3);

    // 静默看门狗的检查频率，比超时更密一些，让恢复原速不至于迟一整个周期。
    private static readonly TimeSpan IdleCheckInterval = TimeSpan.FromSeconds(1);

    private readonly SemaphoreSlim gate = new(1, 1);
    private readonly CancellationTokenSource lifetime = new();
    private PeriodicTimer? worldTimer;

    // 用单调时钟量取真实经过时间：系统时间被改动或轮询被拖慢时，世界推进量依然正确。
    private long lastTickStamp;
    private string? tickError;

    private List<ChatSession> sessions = [];
    private ChatSession? activeSession;
    private int selectedSessionId;

    private List<TimelineEvent> timeline = [];
    private List<TimelineEvent> visibleEvents = [];
    private long lastRenderedSequence = -1;

    // RP 模式的信息封印：只有已离开 RevealQueue（即已揭示）的事件才允许进入长卷。
    private HashSet<string> pendingRevealIds = [];

    private GlobalState? globalState;
    private ProtagonistInfo? protagonist;
    private List<ImportantNpc> npcs = [];
    private List<InventoryItem> inventories = [];
    private List<Quest> quests = [];
    private IReadOnlyList<CharacterSkill> skills = [];
    private List<CastMember> presentCast = [];
    private WorldRuntimeState? runtime;
    private int loopCount;

    private string playerInput = string.Empty;
    private bool showWorldLog;
    private bool asideOpen = true;

    // 输入活动信号：UI 只负责"玩家现在正在组织输入"这一事实，
    // 逻辑时间怎么换算完全由 WorldClockService 决定。
    private bool inputActive;
    private long lastKeystrokeStamp;
    private PeriodicTimer? idleTimer;
    // 草稿内容、按键和中间结果绝不进入时间线或任何 Agent 上下文，只用作调度控制信号。
    private int inputActivitySessionId;

    private bool isSubmitting;
    private bool isSwitching;
    private bool isTogglingPause;
    private bool isCreating;
    private string? errorMessage;

    private bool showNewSessionDialog;
    private string newSessionName = string.Empty;
    private string newSessionMode = "RP";

    private bool IsTheater => activeSession?.GameMode == "Theater";
    private bool IsPaused => activeSession?.IsPaused == 1;
    private int CurrentEpoch => activeSession?.CurrentWorldEpoch ?? 1;
    private double BackpressureFactor => runtime?.GenerationBackpressureFactor ?? 1.0;

    // 以库里持久化的 input_slow_factor 为准，而不是本地 inputActive 标记：
    // 界面显示的必须是世界真正在用的倍率。
    private bool IsInputSlowed =>
        activeSession is not null && !IsPaused && activeSession.InputSlowFactor < 0.999;

    private string InputSlowFactorText =>
        (activeSession?.InputSlowFactor ?? 1.0).ToString("0.00");

    private string EffectiveScaleText
    {
        get
        {
            if (activeSession is null) return "0";
            if (IsPaused) return "0";
            var scale = activeSession.SessionTimeScale * activeSession.InputSlowFactor * BackpressureFactor;
            return scale.ToString("0.##");
        }
    }

    private string WorldClockText =>
        DateTimeOffset.TryParse(activeSession?.WorldClockAnchor, out var anchor)
            ? anchor.ToLocalTime().ToString("MM-dd HH:mm:ss")
            : "—";

    private string? ProtagonistActorId => protagonist is null ? null : $"protagonist:{protagonist.RowId}";

    // 视点场景：剧场模式跟随镜头，RP 模式永远锚定主角自己所在的地方。
    private string? ViewpointScene => IsTheater
        ? globalState?.CurrentLocation
        : protagonist?.LocationName;

    private string ViewpointSceneLabel =>
        string.IsNullOrWhiteSpace(ViewpointScene) ? "未知之地" : ViewpointScene;

    // 世界内部层只属于剧场模式的全知视角。RP 模式下这个开关不渲染、也不参与过滤。
    private bool CanShowWorldLog => IsTheater;

    private int VisibleCount => visibleEvents.Count;

    // RP 模式用本地连续序号渲染，剧场模式用真实 sequence。
    private IEnumerable<(TimelineEvent Item, int Ordinal)> VisibleWithOrdinal =>
        visibleEvents.Select((item, index) => (item, index + 1));

    // 过滤一次就缓存：一次渲染要读三遍可见集合，没必要每次都重算。
    private void RebuildVisibleEvents() =>
        visibleEvents = IsTheater
            ? (showWorldLog ? timeline : timeline.Where(IsForeground).ToList())
            : timeline.Where(IsRevealedToProtagonist).ToList();

    private static bool IsForeground(TimelineEvent item) =>
        ForegroundTypes.Contains(item.EventType, StringComparer.Ordinal);

    // RP 可见性的三重条件：必须是前台类型；必须已离开 RevealQueue；
    // 且除玩家自身操作与系统告知外，必须由主角亲自目击（direct_observers 命中）。
    private bool IsRevealedToProtagonist(TimelineEvent item)
    {
        if (!IsForeground(item)) return false;
        if (pendingRevealIds.Contains(item.EventId)) return false;
        if (PlayerFacingTypes.Contains(item.EventType, StringComparer.Ordinal)) return true;
        var self = ProtagonistActorId;
        return self is not null && DirectObserverIds(item).Contains(self, StringComparer.Ordinal);
    }

    private static IReadOnlyList<string> DirectObserverIds(TimelineEvent item)
    {
        try
        {
            return JsonSerializer.Deserialize<string[]>(item.DirectObservers) ?? [];
        }
        catch (JsonException)
        {
            // 数据损坏时按"看不见"处理：宁可少显示，也不能泄露离屏事实。
            return [];
        }
    }

    private sealed record CastMember(string Name, string Note, bool IsViewpoint);

    private sealed record EventVisual(string Icon, string Label, string Kind);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        StartWorldPolling();
        StartInputIdleWatchdog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var newest = timeline.Count == 0 ? -1 : timeline[^1].Sequence ?? -1;
        if (firstRender || newest != lastRenderedSequence)
        {
            lastRenderedSequence = newest;
            try { await JS.InvokeVoidAsync("scrollElementToBottom", "timelineScroll"); }
            catch { /* JS 尚未就绪 */ }
        }
    }

    // 连续世界不等待玩家：界面按固定节拍驱动世界推进，再拉取已提交事件。
    // 暂停时仍然保持节拍，让核心自己判定跳过，并让恢复能立即被反映。
    private void StartWorldPolling()
    {
        lastTickStamp = Stopwatch.GetTimestamp();
        worldTimer = new PeriodicTimer(TickInterval);
        _ = Task.Run(async () =>
        {
            try
            {
                while (await worldTimer.WaitForNextTickAsync(lifetime.Token))
                {
                    await AdvanceWorldAsync();
                    await ReloadAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        });
    }

    // 把真实经过时间交给核心：逻辑时间换算、暂停跳过、预算与背压全部由 WorldTickGovernor 决定，
    // UI 只负责提供单调的 elapsed 并串行化对 DbContext 的访问。
    private async Task AdvanceWorldAsync()
    {
        var sessionId = activeSession?.SessionId;
        if (sessionId is null) return;

        try
        {
            await gate.WaitAsync(lifetime.Token);
        }
        catch (OperationCanceledException) { return; }
        catch (ObjectDisposedException) { return; }

        try
        {
            // 只在真正 tick 成功后重置基准，避免被别的操作占用时丢失这段真实时间。
            var elapsed = Stopwatch.GetElapsedTime(lastTickStamp);
            if (elapsed <= TimeSpan.Zero) return;
            // 机器休眠/挂起后 elapsed 可能非常大，截断以免世界一次跳跃过远。
            if (elapsed > MaxTickElapsed) elapsed = MaxTickElapsed;

            var result = await TickGovernor.TickAsync(sessionId.Value, elapsed, lifetime.Token);
            lastTickStamp = Stopwatch.GetTimestamp();
            tickError = result.Error;
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception exception)
        {
            // 单次推进失败不能停掉整条世界节拍：记录下来，下一拍继续。
            tickError = exception.Message;
            lastTickStamp = Stopwatch.GetTimestamp();
        }
        finally
        {
            try { gate.Release(); } catch (ObjectDisposedException) { }
        }
    }

    // 键盘停下来之后世界要自己恢复原速：草稿框失焦、玩家走开、忘了提交都算。
    // 草稿非空时不恢复 —— 玩家还在想怎么写，世界应该继续保持慢动作。
    private void StartInputIdleWatchdog()
    {
        idleTimer = new PeriodicTimer(IdleCheckInterval);
        _ = Task.Run(async () =>
        {
            try
            {
                while (await idleTimer.WaitForNextTickAsync(lifetime.Token))
                {
                    if (!inputActive) continue;
                    if (!string.IsNullOrEmpty(playerInput)) continue;
                    if (Stopwatch.GetElapsedTime(lastKeystrokeStamp) < InputIdleTimeout) continue;

                    await SetInputActivityAsync(false, "InputActivityEnded");
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        });
    }

    // 每次按键都刷新静默基准；只在状态真正翻转时才通知核心，避免每个字符一次写库。
    private async Task OnDraftKeystrokeAsync()
    {
        lastKeystrokeStamp = Stopwatch.GetTimestamp();
        if (!inputActive)
        {
            await SetInputActivityAsync(true, "InputActivityStarted");
        }
    }

    // 内容变化（含输入法上屏、粘贴）走这里。
    private Task OnComposerInputAsync() => OnDraftKeystrokeAsync();

    // 按键补上不改变内容的操作：方向键移动光标、退格到空串，也都算在组织输入里。
    private Task OnComposerKeyDownAsync(KeyboardEventArgs args) => OnDraftKeystrokeAsync();

    // 离开输入框且草稿为空，说明玩家放弃了这次输入，不必等静默超时就恢复原速。
    private async Task OnComposerBlurAsync()
    {
        if (inputActive && string.IsNullOrEmpty(playerInput))
        {
            await SetInputActivityAsync(false, "InputActivityEnded");
        }
    }

    // 只有确实处于活动状态才发结束信号，避免重复写入无意义的运行控制事件。
    private Task EndInputActivityIfActiveAsync() =>
        inputActive ? SetInputActivityAsync(false, "InputActivityEnded") : Task.CompletedTask;

    // UI 只上报活动信号，倍率语义交给核心：SetInputActivityAsync 自己写运行控制事件、
    // 校验倍率范围并更新 input_slow_factor。这里不碰世界时钟。
    private async Task SetInputActivityAsync(bool isActive, string controlEventType)
    {
        var sessionId = isActive ? activeSession?.SessionId : ResolveActivitySessionId();
        if (sessionId is null or 0) return;

        // 先翻转本地标记，避免连续按键在 await 期间重复触发同一次状态变更。
        inputActive = isActive;
        inputActivitySessionId = isActive ? sessionId.Value : 0;

        try
        {
            await gate.WaitAsync(lifetime.Token);
        }
        catch (OperationCanceledException) { return; }
        catch (ObjectDisposedException) { return; }

        try
        {
            await WorldClock.SetInputActivityAsync(
                sessionId.Value, isActive, InputSlowFactorValue, controlEventType, lifetime.Token);
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (Exception exception)
        {
            // 慢动作是体验优化，不是正确性前提：失败就回滚本地标记，世界继续按原速跑。
            inputActive = !isActive;
            errorMessage = $"更新输入活动状态失败：{exception.Message}";
        }
        finally
        {
            try { gate.Release(); } catch (ObjectDisposedException) { }
        }
    }

    // 结束活动要回到"当初开始活动的那个会话"，否则切换会话后旧会话会被永久锁在慢动作里。
    private int? ResolveActivitySessionId() =>
        inputActivitySessionId != 0 ? inputActivitySessionId : activeSession?.SessionId;

    private async Task ReloadAsync()
    {
        if (!await gate.WaitAsync(0, lifetime.Token))
        {
            return;
        }
        try
        {
            sessions = (await SessionService.ListSessionsAsync(lifetime.Token)).ToList();
            activeSession = await SessionService.GetActiveSessionAsync(lifetime.Token);
            selectedSessionId = activeSession?.SessionId ?? sessions.FirstOrDefault()?.SessionId ?? 0;

            timeline = activeSession?.CurrentBranchId is string branchId
                ? (await DbContext.TimelineEvents.AsNoTracking()
                    .Where(item => item.BranchId == branchId && item.Status != "Draft" && item.Sequence != null)
                    .OrderByDescending(item => item.Sequence)
                    .Take(150)
                    .ToListAsync(lifetime.Token))
                    .OrderBy(item => item.Sequence)
                    .ToList()
                : [];

            // RevealQueue 中仍为 Pending 的事件是「已提交但尚未择机呈现」的世界事实。
            // RP 模式绝不能提前显示它们；剧场模式的全知视角不受此限制。
            pendingRevealIds = activeSession is null
                ? []
                : (await DbContext.RevealQueue.AsNoTracking()
                    .Where(item => item.SessionId == activeSession.SessionId && item.Status == "Pending")
                    .Select(item => item.EventId)
                    .ToListAsync(lifetime.Token))
                    .ToHashSet(StringComparer.Ordinal);

            globalState = await DbContext.GlobalStates.AsNoTracking().FirstOrDefaultAsync(lifetime.Token);
            protagonist = await DbContext.ProtagonistInfo.AsNoTracking().FirstOrDefaultAsync(lifetime.Token);
            npcs = await DbContext.ImportantNpcs.AsNoTracking().ToListAsync(lifetime.Token);
            inventories = await DbContext.Inventory.AsNoTracking().ToListAsync(lifetime.Token);
            quests = await DbContext.Quests.AsNoTracking().ToListAsync(lifetime.Token);
            skills = SkillsSerializer.Parse(protagonist?.SkillsJson);
            loopCount = await DbContext.DeathReturnLog.AsNoTracking().CountAsync(lifetime.Token);
            runtime = activeSession is null
                ? null
                : await DbContext.WorldRuntimeStates.AsNoTracking()
                    .FirstOrDefaultAsync(item => item.SessionId == activeSession.SessionId, lifetime.Token);

            presentCast = BuildCast();
            // 必须在 protagonist 与 pendingRevealIds 都就位之后再算可见集合。
            RebuildVisibleEvents();
        }
        catch (OperationCanceledException) { }
        catch (Exception exception)
        {
            errorMessage = $"读取世界状态失败：{exception.Message}";
        }
        finally
        {
            gate.Release();
        }
    }

    // 在场角色也是信息面：剧场模式锚定当前镜头，RP 模式锚定主角自己所在的地方，
    // 且场景未知时返回空列表 —— 绝不退化成「列出世界上所有角色」。
    private List<CastMember> BuildCast()
    {
        var scene = ViewpointScene;
        if (string.IsNullOrWhiteSpace(scene)) return [];

        var cast = new List<CastMember>();
        foreach (var npc in npcs.Where(item => item.LocationName == scene))
        {
            cast.Add(new CastMember(npc.Name, string.IsNullOrWhiteSpace(npc.BriefIntro) ? npc.IdentityText : npc.BriefIntro, false));
        }
        if (protagonist is not null && protagonist.LocationName == scene)
        {
            cast.Insert(0, new CastMember(protagonist.Name, protagonist.IdentityText, true));
        }
        return cast;
    }

    private async Task SubmitAsync()
    {
        var content = playerInput.Trim();
        if (string.IsNullOrWhiteSpace(content) || activeSession is null) return;

        isSubmitting = true;
        await gate.WaitAsync(lifetime.Token);
        try
        {
            await Orchestrator.SubmitPlayerInputAsync(content, lifetime.Token);
            playerInput = string.Empty;
        }
        catch (Exception exception)
        {
            errorMessage = $"提交失败：{exception.Message}";
        }
        finally
        {
            gate.Release();
            isSubmitting = false;
        }
        // 提交即结束这次输入活动：草稿已清空，世界必须立刻回到原速，
        // 不能让玩家提交完还白拿几秒慢动作。放在 gate 之外，因为它自己要取 gate。
        await EndInputActivityIfActiveAsync();
        await ReloadAsync();
    }

    private async Task TogglePauseAsync()
    {
        if (activeSession is null) return;
        isTogglingPause = true;
        await gate.WaitAsync(lifetime.Token);
        try
        {
            await WorldClock.SetPausedAsync(activeSession.SessionId, activeSession.IsPaused != 1, lifetime.Token);
        }
        catch (Exception exception)
        {
            errorMessage = $"切换暂停状态失败：{exception.Message}";
        }
        finally
        {
            gate.Release();
            isTogglingPause = false;
        }
        await ReloadAsync();
    }

    private async Task SwitchSessionAsync()
    {
        if (activeSession is not null && selectedSessionId == activeSession.SessionId) return;

        // 切走之前先把旧会话的慢动作解除，否则它会被永久留在 input_slow_factor < 1 的状态。
        // 必须在取 gate 之前调用：SetInputActivityAsync 自己要拿同一把锁。
        await EndInputActivityIfActiveAsync();

        isSwitching = true;
        await gate.WaitAsync(lifetime.Token);
        try
        {
            await SessionService.SwitchSessionAsync(selectedSessionId, lifetime.Token);
            playerInput = string.Empty;
            lastRenderedSequence = -1;
            // 切换期间累积的真实时间不属于新会话，重置基准并清掉上一条世界线的推进错误。
            lastTickStamp = Stopwatch.GetTimestamp();
            tickError = null;
        }
        catch (Exception exception)
        {
            errorMessage = $"切换会话失败：{exception.Message}";
        }
        finally
        {
            gate.Release();
            isSwitching = false;
        }
        await ReloadAsync();
    }

    private void OpenNewSessionDialog()
    {
        newSessionName = string.Empty;
        newSessionMode = activeSession?.GameMode ?? "RP";
        showNewSessionDialog = true;
    }

    private void CloseNewSessionDialog() => showNewSessionDialog = false;

    private async Task CreateSessionAsync()
    {
        if (string.IsNullOrWhiteSpace(newSessionName)) return;
        isCreating = true;
        await gate.WaitAsync(lifetime.Token);
        try
        {
            await SessionService.CreateNewSessionAsync(newSessionName.Trim(), newSessionMode, lifetime.Token);
            showNewSessionDialog = false;
            playerInput = string.Empty;
            lastRenderedSequence = -1;
            // 新世界线从零开始计时，不继承创建前累积的真实时间。
            lastTickStamp = Stopwatch.GetTimestamp();
            tickError = null;
        }
        catch (Exception exception)
        {
            errorMessage = $"创建会话失败：{exception.Message}";
        }
        finally
        {
            gate.Release();
            isCreating = false;
        }
        await ReloadAsync();
    }

    private EventVisual Describe(TimelineEvent item) => item.EventType switch
    {
        "KeplerNarration" => new EventVisual("✦", "开普勒 · 场景叙述", "narration"),
        "ImportedGreeting" => new EventVisual("❖", "序章 · 原样呈现", "narration"),
        "CharacterAction" => new EventVisual("◈", ResolveActorName(item.ActorId) ?? "在场角色", "actor"),
        "PlayerInput" => IsTheater
            ? new EventVisual("✎", "你的导演指令", "direction")
            : new EventVisual("✎", ResolveActorName(item.ActorId) ?? "主角", "player"),
        "RuleResolution" => new EventVisual("⚄", "规则结算", "rule"),
        "WorldRewindCommitted" => new EventVisual("↺", "死亡回归 · 世界回滚", "rewind"),
        "RuntimeControl" => new EventVisual("⏱", "运行控制", "runtime"),
        "SceneOpportunity" => new EventVisual("◦", "行动机会", "world"),
        "DirectorPlan" => new EventVisual("▚", "隐藏导演 · 节拍计划", "world"),
        "StateChangeCommitted" => new EventVisual("⛁", "世界状态提交", "world"),
        "InitialProjection" => new EventVisual("⌂", "世界初始化", "world"),
        _ => new EventVisual("•", item.EventType, "world")
    };

    private string? ResolveActorName(string? actorId)
    {
        if (string.IsNullOrWhiteSpace(actorId)) return null;
        var parts = actorId.Split(':', 2);
        if (parts.Length != 2 || !int.TryParse(parts[1], out var rowId)) return actorId;
        return parts[0] switch
        {
            "protagonist" => protagonist?.RowId == rowId ? protagonist.Name : "主角",
            "npc" => npcs.FirstOrDefault(item => item.RowId == rowId)?.Name ?? actorId,
            _ => actorId
        };
    }

    private string RenderContent(TimelineEvent item)
    {
        var raw = item.EventType switch
        {
            "RuleResolution" => FormatJsonSummary(item.Content, ["command", "outcome", "successLevel", "roll", "detail"]),
            "RuntimeControl" => item.Content.Contains("pause", StringComparison.OrdinalIgnoreCase) ? "世界暂停" : "世界恢复运转",
            "DirectorPlan" => FormatJsonSummary(item.Content, ["beatKind", "narrationNeed", "cameraAction", "requestedIntensity"]),
            "SceneOpportunity" => "调度器给出一次行动机会。",
            "InitialProjection" => "世界初始投影已提交。",
            "StateChangeCommitted" => "结构化状态变更已写入投影。",
            _ => CleanText(item.Content)
        };
        if (string.IsNullOrWhiteSpace(raw))
        {
            raw = "（无正文）";
        }
        return System.Net.WebUtility.HtmlEncode(raw).Replace("\n", "<br />");
    }

    private static string FormatJsonSummary(string content, string[] keys)
    {
        try
        {
            using var document = JsonDocument.Parse(content);
            var pieces = new List<string>();
            foreach (var key in keys)
            {
                foreach (var property in document.RootElement.EnumerateObject())
                {
                    if (!string.Equals(property.Name, key, StringComparison.OrdinalIgnoreCase)) continue;
                    var text = property.Value.ValueKind == JsonValueKind.String
                        ? property.Value.GetString()
                        : property.Value.ToString();
                    if (!string.IsNullOrWhiteSpace(text)) pieces.Add(text!);
                }
            }
            return pieces.Count > 0 ? string.Join(" · ", pieces) : content;
        }
        catch (JsonException)
        {
            return content;
        }
    }

    private static string ShortWorldTime(string? worldTime) =>
        DateTimeOffset.TryParse(worldTime, out var time) ? time.ToLocalTime().ToString("HH:mm") : "--:--";

    private static int Pct(int current, int max) =>
        max <= 0 ? 0 : Math.Clamp((int)Math.Round(current * 100.0 / max), 0, 100);

    private static IEnumerable<KeyValuePair<string, string>> ParseAttributes(string? attributes)
    {
        if (string.IsNullOrWhiteSpace(attributes)) yield break;
        foreach (var chunk in attributes.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = chunk.Split(':', 2);
            if (pair.Length == 2)
            {
                yield return new KeyValuePair<string, string>(pair[0].Trim(), pair[1].Trim());
            }
        }
    }

    // 去掉模型的思考块与遗留模板指令，只留可展示正文。
    private static string CleanText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var cleaned = System.Text.RegularExpressions.Regex.Replace(text, @"<think>[\s\S]*?</think>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"<thought>[\s\S]*?</thought>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"<think>[\s\S]*$", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"</?(think|thought)>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var contentMatch = System.Text.RegularExpressions.Regex.Match(cleaned, @"<content>([\s\S]*?)</content>", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (contentMatch.Success) cleaned = contentMatch.Groups[1].Value;
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"</?content>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"<update>[\s\S]*?</update>", "");
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"_\.set\(\s*['""].*?['""]\s*,\s*.*?\);?", "");
        return cleaned.Trim();
    }

    public async ValueTask DisposeAsync()
    {
        // input_slow_factor 是持久化字段。离开页面时若还停在慢动作，下次打开世界会莫名以四分之一速度跑，
        // 所以先尽力恢复原速，再取消节拍。用 None 是因为 lifetime 马上就要被取消。
        if (inputActive && inputActivitySessionId != 0)
        {
            try
            {
                await WorldClock.SetInputActivityAsync(
                    inputActivitySessionId, false, InputSlowFactorValue, "InputActivityEnded", CancellationToken.None);
            }
            catch { /* 页面正在销毁，作用域可能已经关闭；恢复失败不影响退出 */ }
        }

        await lifetime.CancelAsync();
        worldTimer?.Dispose();
        idleTimer?.Dispose();
        lifetime.Dispose();
        gate.Dispose();
    }
}
