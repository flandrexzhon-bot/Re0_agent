                                                {
                                                    <span class="skill-mp">魔@(skill.ManaCost)</span>
                                                }
                                                @if (skill.StaminaCost > 0)
                                                {
                                                    <span class="skill-sp">体@(skill.StaminaCost)</span>
                                                }
                                                @if (!skill.Available)
                                                {
                                                    <span class="skill-unavailable">不可用</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="mt-2"><span class="attr-label">权能/加护:</span> @(string.IsNullOrEmpty(protagonistInfo.SpecialAttributes) ? "无" : protagonistInfo.SpecialAttributes)</div>
                            <div class="mt-1"><span class="attr-label">携带物资:</span> @(string.IsNullOrEmpty(protagonistInfo.ResourcesText) ? "无" : protagonistInfo.ResourcesText)</div>
