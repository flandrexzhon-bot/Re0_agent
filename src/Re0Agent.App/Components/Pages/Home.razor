                                    {
                                        <option value="@p.AgentName">@p.AgentName</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="text-gold" style="font-size: 0.8rem; display: block; margin-bottom: 0.2rem;">投骰GM (裁判)：</label>
                                <select class="form-select parchment-input" @bind="selectedDicePreset" style="font-size: 0.85rem; padding: 0.25rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);">
                                    <option value="">-- 未选择 (默认首个) --</option>
                                    @foreach (var p in agentConfigs)
                                    {
                                        <option value="@p.AgentName">@p.AgentName</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="text-gold" style="font-size: 0.8rem; display: block; margin-bottom: 0.2rem;">判定延迟 (s)：@delaySeconds 秒</label>
                                <input type="range" min="0" max="5" step="0.5" @bind="delaySeconds" style="width: 100%;" />
                            </div>
                            <div>
                                <label class="text-gold" style="font-size: 0.8rem; display: block; margin-bottom: 0.2rem;">Memory (填表)：</label>
                                <select class="form-select parchment-input" @bind="selectedMemoryPreset" style="font-size: 0.85rem; padding: 0.25rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);">
                                    <option value="">-- 未选择 (默认首个) --</option>
                                    @foreach (var p in agentConfigs)
                                    {
                                        <option value="@p.AgentName">@p.AgentName</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="text-gold" style="font-size: 0.8rem; display: block; margin-bottom: 0.2rem;">任务接力 (角色调度)：</label>
                                <select class="form-select parchment-input" @bind="selectedCharacterSubPreset" style="font-size: 0.85rem; padding: 0.25rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);">
                                    <option value="">-- 未选择 (回退 GM) --</option>
                                    @foreach (var p in agentConfigs)
                                    {
                                        <option value="@p.AgentName">@p.AgentName</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="text-gold" style="font-size: 0.8rem; display: block; margin-bottom: 0.2rem;">章节切换 (帕秋莉)：</label>
                                <select class="form-select parchment-input" @bind="selectedChapterSwitchPreset" style="font-size: 0.85rem; padding: 0.25rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);">
                                    <option value="">-- 未选择 (回退 GM) --</option>
                                    @foreach (var p in agentConfigs)
                                    {
                                        <option value="@p.AgentName">@p.AgentName</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="inline-toggle" style="font-size: 0.8rem;">
                                    <input type="checkbox" @bind="streamingEnabled" @bind:after="SaveStreamingAsync" />
                                    <span>开启流式传输</span>
                                </label>
                            </div>

                            <div>
                                <label class="inline-toggle" style="font-size: 0.8rem;">
                                    <input type="checkbox" @bind="autoRetryEnabled" @bind:after="SaveAutoRetryAsync" />
