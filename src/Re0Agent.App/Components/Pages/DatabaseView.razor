@page "/database"
@inject DatabaseLocation DatabaseLocation

<PageTitle>数据库</PageTitle>

<section class="page-heading">
    <h1>数据库</h1>
    <p>@DatabaseLocation.Path</p>
</section>

<section class="work-surface">
    <h2>Phase 1 表结构</h2>
    <div class="table-list">
        @foreach (var tableName in DatabaseSchema.ExpectedTableNames)
        {
            <span>@tableName</span>
        }
    </div>
</section>
