    private ProtagonistInfo ReadTemplateProtagonist(string baseData)
    {
        using var document = JsonDocument.Parse(baseData);
        var element = document.RootElement.TryGetProperty("protagonist", out var protagonistElement)
            ? protagonistElement
            : document.RootElement;

        return element.Deserialize<ProtagonistInfo>(JsonOptions)
            ?? new ProtagonistInfo { Name = "", Gender = "男", Age = 17, Appearance = "", IdentityText = "", SelfStatus = "正常", LocationName = "王都", BaseAttributes = "" };
    }

    private string GetTemplateBrief(ProtagonistTemplate tpl)
    {
        try
        {
            var p = ReadTemplateProtagonist(tpl.BaseData);
            return $"{p.Gender} / {p.Age}岁 / 初始位置：{p.LocationName}\n{p.IdentityText}";
        }
        catch
        {
            return "模板数据解析失败";
        }
    }

