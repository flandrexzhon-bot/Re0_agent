                                                {
                                                    <span class="equip-slot-name equip-empty-text">未装备</span>
                                                }
                                            </div>
                                            @if (eq is not null && !string.IsNullOrWhiteSpace(eq.Description))
                                            {
                                                <div class="equip-slot-desc" title="@eq.Description">@eq.Description</div>
