@code {
    private enum RoundPhase { Idle, GmRunning, NpcRunning, AwaitingPlayer, Finalizing }

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    private string playerInput = string.Empty;
    private bool skipPlayerTurn;
    private string? errorMessage;

    private RoundPhase phase = RoundPhase.Idle;
    private bool isBusy;
    private GameRound? activeRound;
    private readonly List<GameRound> sessionRounds = new();

    private List<ChatSession> chatSessions = new();
    private int activeSessionId;
    private string newSessionName = string.Empty;

    private int currentChapter = 1;
    private int loopCount = 0;
    private int miasmaLevel = 0;
    private bool showDeathGlitch = false;
    private bool hasProtagonist = false;
    private List<ChronicleEntry> chronicles = new();
    private IReadOnlyList<ProtagonistTemplate> templates = new List<ProtagonistTemplate>();

    private bool sidebarExpanded = true;

    private ProtagonistInfo? protagonistInfo;
    private List<InventoryItem> inventories = new();
    private List<EquipmentItem> equipments = new();
    private string? locationDescription;
    private string? locationRegion;

    // Model configuration parameters
    private List<ImportantNpc> presentNpcs = new();
    private List<string> allCharacterNames = new();
    private List<Re0Agent.Core.Entities.AgentConfig> agentConfigs = new();

    private string selectedGmPreset = string.Empty;
    private string selectedNpcPreset = string.Empty;
    private string selectedDicePreset = string.Empty;
    private string selectedMemoryPreset = string.Empty;
    private double delaySeconds = 0.0;

    private List<CharacterBinding> characterBindings = new();
    private List<TempNpcBinding> tempNpcBindings = new();

    public class CharacterBinding
    {
        public string CharacterName { get; set; } = string.Empty;
        public string PresetName { get; set; } = string.Empty;
    }

    public class TempNpcBinding
    {
        public string NpcName { get; set; } = string.Empty;
        public string PresetName { get; set; } = string.Empty;
    }

    private void AddCharacterBinding()
    {
        characterBindings.Add(new CharacterBinding());
    }

    private void RemoveCharacterBinding(CharacterBinding b)
    {
        characterBindings.Remove(b);
    }

    private void AddTempNpcBinding()
    {
        tempNpcBindings.Add(new TempNpcBinding());
    }

    private void RemoveTempNpcBinding(TempNpcBinding b)
    {
        tempNpcBindings.Remove(b);
    }

    protected override async Task OnInitializedAsync()
    {
        await SessionService.EnsureDefaultSessionAsync();
        var activeSession = await SessionService.GetActiveSessionAsync();
        if (activeSession is not null)
        {
            try
            {
                var rounds = JsonSerializer.Deserialize<List<GameRound>>(activeSession.DetailedRoundsSnapshot, JsonOptions);
                if (rounds is not null)
                {
                    sessionRounds.Clear();
                    sessionRounds.AddRange(rounds);
                }
            }
            catch
            {
                // ignore
            }
        }
        await LoadDatabaseStateAsync();
    }

    private async Task AutoSaveChatSessionAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(sessionRounds, JsonOptions);
            await SessionService.SaveActiveSessionStateAsync(json);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Autosave error: {ex.Message}");
        }
    }

    private async Task BeginRoundAsync()
    {
        isBusy = true;
        phase = RoundPhase.GmRunning;
        errorMessage = null;
        try
        {
            // 第一阶段：GM 开场
            var round = await Orchestrator.BeginRoundAsync(onStepCompleted: async (r) =>
            {
                await AutoSaveChatSessionAsync();
                StateHasChanged();
                await Task.Delay(10);
            });
            activeRound = round;
            sessionRounds.Add(round);
            await AutoSaveChatSessionAsync();

            if (round.DeathReturnTriggered)
            {
                await HandleRoundCompletionAsync(round);
                return;
            }

            // 第二阶段：NPC 响应
            phase = RoundPhase.NpcRunning;
            StateHasChanged();

            await Orchestrator.RunNpcTurnsAsync(round, onStepCompleted: async (r) =>
            {
                await AutoSaveChatSessionAsync();
                StateHasChanged();
                await Task.Delay(10);
            });

            if (round.DeathReturnTriggered)
            {
                await HandleRoundCompletionAsync(round);
                return;
            }

            // 第三阶段：等待玩家输入主角动作
            phase = RoundPhase.AwaitingPlayer;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            RollbackActiveRound();
            phase = RoundPhase.Idle;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SubmitPlayerTurnAsync()
    {
        if (activeRound is null)
        {
            phase = RoundPhase.Idle;
            return;
        }

        isBusy = true;
        phase = RoundPhase.Finalizing;
        errorMessage = null;
        try
        {
            var round = await Orchestrator.CompletePlayerTurnAsync(activeRound, playerInput, skipPlayerTurn, onStepCompleted: async (r) =>
            {
                await AutoSaveChatSessionAsync();
                StateHasChanged();
                await Task.Delay(10);
            });
            await HandleRoundCompletionAsync(round);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            phase = RoundPhase.AwaitingPlayer;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleRoundCompletionAsync(GameRound round)
    {
        if (round.DeathReturnTriggered)
        {
            showDeathGlitch = true;
            StateHasChanged();
            await Task.Delay(1800);
            showDeathGlitch = false;
        }

        playerInput = string.Empty;
        activeRound = null;
        phase = RoundPhase.Idle;
        await LoadDatabaseStateAsync();
        await AutoSaveChatSessionAsync();
    }

    private void RollbackActiveRound()
    {
        if (activeRound is not null)
        {
            sessionRounds.Remove(activeRound);
            activeRound = null;
        }
    }

    private async Task ApplyTemplateAsync(int templateId)
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            await TemplateService.ApplyTemplateAsync(templateId);
            sessionRounds.Clear();
            activeRound = null;
            phase = RoundPhase.Idle;
            await LoadDatabaseStateAsync();
            await AutoSaveChatSessionAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"应用主角模板失败: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OnSessionChangedAsync()
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            var currentJson = JsonSerializer.Serialize(sessionRounds, JsonOptions);
            var targetJson = await SessionService.SwitchSessionAsync(activeSessionId, currentJson);
            
            sessionRounds.Clear();
            var rounds = JsonSerializer.Deserialize<List<GameRound>>(targetJson, JsonOptions);
            if (rounds is not null)
            {
                sessionRounds.AddRange(rounds);
            }
            activeRound = null;
            phase = RoundPhase.Idle;
            
            await LoadDatabaseStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"切换会话失败: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task CreateSessionAsync()
    {
        if (string.IsNullOrWhiteSpace(newSessionName))
        {
            errorMessage = "会话名称不能为空。";
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            var name = newSessionName.Trim();
            newSessionName = string.Empty;

            var emptyRounds = await SessionService.CreateNewSessionAsync(name);
            sessionRounds.Clear();
            activeRound = null;
            phase = RoundPhase.Idle;

            await LoadDatabaseStateAsync();
            
            // Reload sessions list
            chatSessions = (await SessionService.ListSessionsAsync()).ToList();
            var active = chatSessions.FirstOrDefault(s => s.IsActive == 1);
            activeSessionId = active?.SessionId ?? 0;

            showDeathGlitch = true;
            StateHasChanged();
            await Task.Delay(1000);
            showDeathGlitch = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"新建会话失败: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteCurrentSessionAsync()
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            await SessionService.DeleteSessionAsync(activeSessionId);
            sessionRounds.Clear();
            activeRound = null;
            phase = RoundPhase.Idle;

            chatSessions = (await SessionService.ListSessionsAsync()).ToList();
            var active = chatSessions.FirstOrDefault(s => s.IsActive == 1);
            activeSessionId = active?.SessionId ?? 0;

            if (active is not null)
            {
                var rounds = JsonSerializer.Deserialize<List<GameRound>>(active.DetailedRoundsSnapshot, JsonOptions);
                if (rounds is not null)
                {
                    sessionRounds.AddRange(rounds);
                }
            }

            await LoadDatabaseStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"删除会话失败: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadDatabaseStateAsync()
    {
        try
        {
            var state = await DbContext.GlobalStates.AsNoTracking().FirstOrDefaultAsync();
            currentChapter = state?.CurrentChapter ?? 1;

            chatSessions = (await SessionService.ListSessionsAsync()).ToList();
            var active = chatSessions.FirstOrDefault(s => s.IsActive == 1);
            activeSessionId = active?.SessionId ?? 0;

            hasProtagonist = await DbContext.ProtagonistInfo.AsNoTracking().AnyAsync();
            templates = await TemplateService.ListTemplatesAsync();

            bool isChatEmpty = sessionRounds.Count == 0;
            if ((!hasProtagonist || isChatEmpty) && !isInitializingGame && !isStartingAdventure)
            {
                isInitializingGame = true;
                initStep = 1;
            }

            var latestLog = await DbContext.DeathReturnLog.AsNoTracking()
                .OrderByDescending(item => item.LogId)
                .FirstOrDefaultAsync();
            loopCount = latestLog?.LoopCount ?? 0;
            miasmaLevel = latestLog?.MiasmaLevel ?? 0;

            chronicles = await DbContext.Chronicle.AsNoTracking()
                .OrderBy(c => c.RowId)
                .ToListAsync();

            protagonistInfo = await DbContext.ProtagonistInfo.AsNoTracking().FirstOrDefaultAsync();
            if (protagonistInfo is not null)
            {
                inventories = await DbContext.Inventory.AsNoTracking().ToListAsync();
                equipments = await DbContext.Equipment.AsNoTracking().ToListAsync();
                var loc = await DbContext.WorldMapPoints.AsNoTracking()
                    .FirstOrDefaultAsync(w => w.LocationName == protagonistInfo.LocationName);
                if (loc is not null)
                {
                    locationDescription = loc.EnvironmentDesc;
                    locationRegion = $"{loc.MajorRegion} · {loc.MinorRegion}";
                }
                else
                {
                    locationDescription = "未知的异世界区域";
                    locationRegion = "未知领域";
                }
            }
            else
            {
                inventories.Clear();
                equipments.Clear();
                locationDescription = null;
                locationRegion = null;
            }

            // Load presets, npcs, routings
            presentNpcs = await DbContext.ImportantNpcs.AsNoTracking().Where(n => n.PresenceStatus == "在场").ToListAsync();
            allCharacterNames = await DbContext.ImportantNpcs.AsNoTracking().Select(n => n.Name).ToListAsync();
            agentConfigs = await DbContext.AgentConfig.AsNoTracking().Where(c => c.Enabled == 1).ToListAsync();

            var routings = await DbContext.ApiRoutings.ToListAsync();
            selectedGmPreset = routings.FirstOrDefault(r => r.RoutingKey == "GM")?.PresetName ?? string.Empty;
            selectedNpcPreset = routings.FirstOrDefault(r => r.RoutingKey == "NPC")?.PresetName ?? string.Empty;
            selectedDicePreset = routings.FirstOrDefault(r => r.RoutingKey == "Dice")?.PresetName ?? string.Empty;
            selectedMemoryPreset = routings.FirstOrDefault(r => r.RoutingKey == "Memory")?.PresetName ?? string.Empty;

            var delayStr = routings.FirstOrDefault(r => r.RoutingKey == "Delay")?.PresetName;
            if (double.TryParse(delayStr, out var dVal))
            {
                delaySeconds = dVal;
            }
            else
            {
                delaySeconds = 0.0;
            }

            characterBindings = routings
                .Where(r => r.RoutingKey.StartsWith("Character_"))
                .Select(r => new CharacterBinding
                {
                    CharacterName = r.RoutingKey.Substring("Character_".Length),
                    PresetName = r.PresetName
                })
                .ToList();

            tempNpcBindings = routings
                .Where(r => r.RoutingKey.StartsWith("TempNpc_"))
                .Select(r => new TempNpcBinding
                {
                    NpcName = r.RoutingKey.Substring("TempNpc_".Length),
                    PresetName = r.PresetName
                })
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"加载状态错误: {ex.Message}";
        }
    }

    private async Task SaveRoutingConfigAsync()
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            var existing = await DbContext.ApiRoutings.ToListAsync();
            DbContext.ApiRoutings.RemoveRange(existing);

            var newRoutings = new List<ApiRouting>();
            if (!string.IsNullOrWhiteSpace(selectedGmPreset))
                newRoutings.Add(new ApiRouting { RoutingKey = "GM", PresetName = selectedGmPreset });
            if (!string.IsNullOrWhiteSpace(selectedNpcPreset))
                newRoutings.Add(new ApiRouting { RoutingKey = "NPC", PresetName = selectedNpcPreset });
            if (!string.IsNullOrWhiteSpace(selectedDicePreset))
                newRoutings.Add(new ApiRouting { RoutingKey = "Dice", PresetName = selectedDicePreset });
            
            newRoutings.Add(new ApiRouting { RoutingKey = "Delay", PresetName = delaySeconds.ToString(System.Globalization.CultureInfo.InvariantCulture) });

            if (!string.IsNullOrWhiteSpace(selectedMemoryPreset))
                newRoutings.Add(new ApiRouting { RoutingKey = "Memory", PresetName = selectedMemoryPreset });

            foreach (var b in characterBindings)
            {
                if (!string.IsNullOrWhiteSpace(b.CharacterName) && !string.IsNullOrWhiteSpace(b.PresetName))
                {
                    newRoutings.Add(new ApiRouting { RoutingKey = "Character_" + b.CharacterName.Trim(), PresetName = b.PresetName });
                }
            }

            foreach (var b in tempNpcBindings)
            {
                if (!string.IsNullOrWhiteSpace(b.NpcName) && !string.IsNullOrWhiteSpace(b.PresetName))
                {
                    newRoutings.Add(new ApiRouting { RoutingKey = "TempNpc_" + b.NpcName.Trim(), PresetName = b.PresetName });
                }
            }

            DbContext.ApiRoutings.AddRange(newRoutings);
            await DbContext.SaveChangesAsync();
            
            await LoadDatabaseStateAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"保存模型配置路由失败: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private string GetDiceSuccessClass(string? successLevel)
    {
        if (string.IsNullOrWhiteSpace(successLevel)) return "";
        var sl = successLevel.ToLower();
        if (sl.Contains("大成功") || sl.Contains("极难成功") || sl.Contains("困难成功") || sl.Contains("成功"))
        {
            return "success-level-great";
        }
        if (sl.Contains("大失败") || sl.Contains("失败"))
        {
            return "success-level-fail";
        }
        return "";
    }

    private string FormatDiceResult(DiceResult? result)
    {
        if (result is null) return "未执行";
        var rollText = result.Roll is null
            ? string.Empty
            : $"，骰值{result.Roll}/{result.TargetAfterModifiers ?? result.Target}";
        var detail = string.IsNullOrWhiteSpace(result.Detail) ? string.Empty : $"，{result.Detail}";
        return $"{result.Command} => {result.Outcome}/{result.SuccessLevel}{rollText}{detail}";
    }

