                            <!-- 生命/魔法/体力 三条资源条 -->
                            <div class="stat-bars">
                                <div class="stat-bar-row">
                                    <span class="stat-bar-label">❤️ 生命</span>
                                    <div class="stat-bar-track">
                                        <div class="stat-bar-fill stat-hp" style="width: @StatPercent(protagonistInfo.Hp, protagonistInfo.MaxHp)%;"></div>
                                    </div>
                                    <span class="stat-bar-value">@protagonistInfo.Hp/@protagonistInfo.MaxHp</span>
                                </div>
                                <div class="stat-bar-row">
                                    <span class="stat-bar-label">🔷 魔法</span>
                                    <div class="stat-bar-track">
                                        <div class="stat-bar-fill stat-mp" style="width: @StatPercent(protagonistInfo.Mp, protagonistInfo.MaxMp)%;"></div>
                                    </div>
                                    <span class="stat-bar-value">@protagonistInfo.Mp/@protagonistInfo.MaxMp</span>
                                </div>
                                <div class="stat-bar-row">
                                    <span class="stat-bar-label">⚡ 体力</span>
                                    <div class="stat-bar-track">
                                        <div class="stat-bar-fill stat-stamina" style="width: @StatPercent(protagonistInfo.Stamina, protagonistInfo.MaxStamina)%;"></div>
                                    </div>
                                    <span class="stat-bar-value">@protagonistInfo.Stamina/@protagonistInfo.MaxStamina</span>
                                </div>
                            </div>

                            <!-- 六维属性 -->
                            <div class="mt-2"><span class="attr-label">六维属性：</span><span style="font-size: 0.75rem; color: var(--color-text-secondary);">（护甲 @protagonistInfo.Armor）</span></div>
                            <div class="attr-grid">
                                @if (!string.IsNullOrEmpty(protagonistInfo.BaseAttributes))
                                {
                                    @foreach (var attr in protagonistInfo.BaseAttributes.Split(';', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        var parts = attr.Split(':');
                                        if (parts.Length == 2)
                                        {
                                            <div class="attr-item">
                                                <span class="attr-label">@parts[0].Trim()</span>
                                                <span class="attr-value">@parts[1].Trim()</span>
                                            </div>
                                        }
                                    }
                                }
                            </div>

                            <!-- 技能列表 -->
                            <div class="mt-2"><span class="attr-label">技能：</span></div>
                            @{
                                var skills = SkillsSerializer.Parse(protagonistInfo.SkillsJson);
                            }
                            @if (skills.Count == 0)
                            {
                                <div style="font-size: 0.8rem; font-style: italic; color: var(--color-text-secondary);">暂无技能</div>
                            }
                            else
                            {
                                <div class="skill-list">
                                    @foreach (var skill in skills)
                                    {
                                        <div class="skill-pill @(skill.Available ? "" : "skill-disabled")" title="@skill.Description">
