@page "/"
@using Microsoft.EntityFrameworkCore
@using Re0Agent.Core.Models
@using Re0Agent.Core.Services.Agent
@using Re0Agent.Core.Entities
@using Re0Agent.Core.Database
@using Re0Agent.Core.Services.Database
@using System.Text.Json
@using System.Text.Encodings.Web
@inject AgentOrchestrator Orchestrator
@inject Re0AgentDbContext DbContext
@inject ProtagonistTemplateService TemplateService
@inject ChatSessionService SessionService
@inject GameProgressService Progress
@inject IJSRuntime JS
@implements IDisposable


<PageTitle>命运之卷 - Re:Zero RPG</PageTitle>

<!-- 死亡回归 Glitch 动画遮罩 -->
<div class="death-glitch-overlay @(showDeathGlitch ? "active" : "")">
    <div class="death-glitch-text">死 亡 回 归</div>
</div>


@if (isInitializingGame)
{
    <div class="game-init-wizard-container">
        <div class="wizard-box">
            @if (initStep == 1)
            {
                <!-- Step 1: Welcome -->
                <div class="wizard-step step-welcome">
                    <h1 class="wizard-title">Re:Zero AI Agent RPG</h1>
                    <h2 class="wizard-subtitle">—— 命 运 编 织 与 轮 回 之 轴 ——</h2>
                    <div class="wizard-divider"></div>
                    <p class="wizard-intro-text">
                        这是一个由 AI 驱动的 Re:Zero 桌面角色扮演（TRPG）与互动小说系统。<br />
                        在这里，您将扮演主角，在 GM 与 NPC 智能体的交织演绎下推进剧情，挑战死亡，探索宿命。
                    </p>
                    <button class="wizard-btn-start" @onclick="GoToStep2">开始游戏</button>
                </div>
            }
            else if (initStep == 2)
            {
                <!-- Step 2: Select or Create Protagonist -->
                <div class="wizard-step step-protagonist">
                    <h3 class="wizard-step-title">第一步：选择或定制主角</h3>
                    
                    <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; justify-content: center;">
                        <button type="button" class="btn-custom @(!isCustomProtagonist ? "primary-action" : "")" @onclick="() => ToggleCustomProtagonist(false)" style="font-size: 0.85rem; padding: 0.35rem 1rem;">选择预设主角模板</button>
                        <button type="button" class="btn-custom @(isCustomProtagonist ? "primary-action" : "")" @onclick="() => ToggleCustomProtagonist(true)" style="font-size: 0.85rem; padding: 0.35rem 1rem;">定制专属角色</button>
                    </div>

                    @if (!isCustomProtagonist)
                    {
                        <div class="template-selector" style="width: 100%; margin-bottom: 1.5rem;">
                            <h4 class="sub-section-title">选择预设模板</h4>
                            <div class="template-list-scroll" style="max-height: 250px;">
                                @foreach (var tpl in templates)
                                {
                                    <div class="template-card @(selectedTemplateId == tpl.TemplateId ? "selected" : "")" @onclick="() => SelectTemplate(tpl)">
                                        <div class="template-name">@tpl.TemplateName</div>
                                        <div class="template-desc">@GetTemplateBrief(tpl)</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="template-creator" style="width: 100%; margin-bottom: 1.5rem;">
                            <h4 class="sub-section-title">定制专属角色</h4>
                            <div class="creator-form" style="max-height: 280px;">
                                <div class="form-row">
                                    <label>姓名：</label>
                                    <input type="text" class="wizard-input" @bind="Progress.CustomProtagonist.Name" placeholder="例如：菜月昴" />
                                </div>
                                <div class="form-row-group">
                                    <div class="form-row">
                                        <label>性别：</label>
                                        <input type="text" class="wizard-input" @bind="Progress.CustomProtagonist.Gender" placeholder="男" />
                                    </div>
                                    <div class="form-row">
                                        <label>年龄：</label>
                                        <input type="number" class="wizard-input" @bind="Progress.CustomProtagonist.Age" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <label>初始位置：</label>
                                    <input type="text" class="wizard-input" @bind="Progress.CustomProtagonist.LocationName" placeholder="例如：王都 / 罗兹瓦尔宅邸" />
                                </div>
                                <div class="form-row">
                                    <label>外貌特征：</label>
                                    <textarea class="wizard-input-area" @bind="Progress.CustomProtagonist.Appearance" placeholder="外貌服饰特征描述"></textarea>
                                </div>
                                <div class="form-row">
                                    <label>身份背景：</label>
                                    <textarea class="wizard-input-area" @bind="Progress.CustomProtagonist.IdentityText" placeholder="主角身世、身份 and 能力简介"></textarea>
                                </div>
                                <div class="form-row">
                                    <label>基础属性：</label>
                                    <input type="text" class="wizard-input" @bind="Progress.CustomProtagonist.BaseAttributes" placeholder="体质:45; 敏捷:55; 感知:60; 意志:70" />
                                </div>
                                <div class="form-row">
                                    <label>特异属性：</label>
                                    <input type="text" class="wizard-input" @bind="Progress.CustomProtagonist.SpecialAttributes" placeholder="例如：死亡回归:特殊" />
                                </div>
                                <div class="form-row">
                                    <label>随身资源：</label>
                                    <input type="text" class="wizard-input" @bind="Progress.CustomProtagonist.ResourcesText" placeholder="例如：手机; 方便面" />
                                </div>
                                <div class="form-row checkbox-row">
                                    <input type="checkbox" id="includeSubaru" @bind="Progress.IncludeSubaruAsNpc" style="cursor: pointer; width: 16px; height: 16px;" />
                                    <label for="includeSubaru" style="margin-left: 0.5rem;">若不使用菜月昴为主体，是否将菜月昴保留为在场 NPC？</label>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="wizard-actions">
                        <button class="wizard-btn-secondary" @onclick="GoToStep1">返回</button>
                        <button class="wizard-btn-primary" @onclick="GoToStep3" disabled="@(!IsValidProtagonist())">下一步：选择初始章节</button>
                    </div>
                </div>
            }
            else if (initStep == 3)
            {
                <!-- Step 3: Select Chapter -->
                <div class="wizard-step step-chapter">
                    <h3 class="wizard-step-title">第二步：选择初始章节</h3>
                    
                    <div class="chapter-selection-list">
                        @foreach (var ch in availableChapters)
                        {
                            <div class="chapter-card @(Progress.SelectedChapter == ch.Number ? "selected" : "")" @onclick="() => SelectChapter(ch.Number)">
                                <div class="chapter-num">第 @ch.Number 章</div>
                                <div class="chapter-title">@ch.Title</div>
                                <div class="chapter-desc">@ch.Desc</div>
                                @if (autoSelectedChapter == ch.Number)
                                {
                                    <span class="chapter-recommend-tag">✨ 推荐（基于主角初始位置）</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="wizard-actions">
                        <button class="wizard-btn-secondary" @onclick="GoToStep2">上一步</button>
                        <button class="wizard-btn-primary" @onclick="GoToStep4">下一步：自定义开场白</button>
                    </div>
                </div>
            }
            else if (initStep == 4)
            {
                <!-- Step 4: Custom Opening Message -->
                <div class="wizard-step step-custom-opening">
                    <h3 class="wizard-step-title">第三步：自定义开场白（可以空着）</h3>
                    
                    <div class="custom-opening-input-box" style="width: 100%; margin-bottom: 1.5rem;">
                        <p class="wizard-intro-text" style="font-size: 0.85rem; margin-bottom: 0.5rem; text-align: left;">
                            您可以输入本局游戏的自定义开场白（当前正在发生的事）。如果留空，系统将自动由 GM 生成。
                        </p>
                        <textarea class="wizard-input-area" @bind="Progress.CustomOpeningMessage" rows="6" 
                                  placeholder="留空则由 GM 自动安排开场，亦可在此输入如：'你从一片黑暗中醒来，耳边传来水果摊贩的吆喝声...'"></textarea>
                    </div>

                    <div class="wizard-actions">
                        <button class="wizard-btn-secondary" @onclick="GoToStep3">上一步</button>
                        <button class="wizard-btn-primary wizard-btn-embark" @onclick="EmbarkOnAdventure">开启宿命之路</button>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="novel-layout-container">
    <div class="fate-book fate-book--novel">
        <!-- 顶部状态面板 -->
        <div class="novel-header-bar">
            <div class="novel-header-badge chapter">章节 @currentChapter</div>
            @if (loopCount > 0)
            {
                <div class="novel-header-badge loop-badge">LOOP @loopCount</div>
            }
        </div>

        <!-- 命运之卷编年史日志 -->
        <section class="work-surface grimoire-log" id="grimoireLogScroll">
            <h2>编年史 / 命运之卷</h2>

            <!-- 跨 session 持久历史纪要 -->
            @foreach (var entry in chronicles)
            {
                <div class="grimoire-entry gm-narrative">
                    <div class="entry-header">
                        @if (entry.CodeIndex == "AM0000")
                        {
                            <span>前序故事</span>
                        }
                        else
                        {
                            <span>@entry.CodeIndex (@entry.TimeSpan)</span>
                        }
                    </div>
                    <div class="entry-body">@((MarkupString)CleanEjsText(entry.ChronicleText))</div>
                </div>
            }

            <!-- 本次会话内已进行/进行中的回合（保留气泡与检定卡片）。仅显示最近 3 个回合，更早的由上方编年史(AM)覆盖。 -->
            @{
                var visibleRounds = sessionRounds.Count > 3 ? sessionRounds.Skip(sessionRounds.Count - 3).ToList() : sessionRounds;
                var latestRound = sessionRounds.LastOrDefault();
            }
            @foreach (var round in visibleRounds)
            {
                var isLatest = ReferenceEquals(round, latestRound);
                var canSwipe = isLatest && Progress.CanReRoll && (round.CompletedAt is not null || phase == RoundPhase.Interrupted);

                <div class="system-event-log" style="display: flex; align-items: center; justify-content: center; gap: 0.6rem;">
                    <span>─── 命运分歧点：@round.RoundIndex ───</span>
                    @if (round.BaseSavePointId is not null && !isBusy)
                    {
                        <button type="button" title="Fork：从此处引入新叙事分支（回溯世界状态，不计入死亡）" disabled="@isBusy"
                                style="background: none; border: none; cursor: pointer; color: var(--color-purple-glow); font-size: 1rem; padding: 0 0.2rem;"
                                @onclick="() => ForkAt(round)">⑂</button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(round.GmOpening))
                {
                    <div class="grimoire-entry gm-narrative">
                        <div class="entry-header">
                            <span>GM 引入叙事</span>
                            @if (canSwipe)
                            {
                                <span class="reroll-swipe" style="display: inline-flex; align-items: center; gap: 0.35rem; margin-left: auto; font-size: 0.8rem;">
                                    <button type="button" title="上一个版本" disabled="@(Progress.ActiveVariantIndex <= 0)"
                                            class="swipe-btn" @onclick="() => SelectVariant(Progress.ActiveVariantIndex - 1)">&lt;</button>
                                    <span style="color: var(--color-text-secondary);">@(Progress.ActiveVariantIndex + 1)/@Progress.CurrentVariantCount</span>
                                    @if (Progress.ActiveVariantIndex < Progress.CurrentVariantCount - 1)
                                    {
                                        <button type="button" title="下一个版本" class="swipe-btn" @onclick="() => SelectVariant(Progress.ActiveVariantIndex + 1)">&gt;</button>
                                    }
                                    else
                                    {
                                        <button type="button" title="重新生成开场并整局重跑" class="swipe-btn" @onclick="() => ReRoll(-1, true)">&gt;</button>
                                    }
                                </span>
                            }
                        </div>
                        <div class="entry-body">@((MarkupString)CleanEjsText(round.GmOpening))</div>
                    </div>
                }

                @for (int ti = 0; ti < round.CharacterTurns.Count; ti++)
                {
                    var turn = round.CharacterTurns[ti];
                    var turnIndex = ti;
                    <div class="grimoire-entry">
                        <div class="character-speech-bubble @(turn.IsPlayerControlled ? "player-bubble" : "npc-bubble")">
                            <div class="bubble-avatar">@turn.CharacterName.Substring(0, 1)</div>
                            <div class="bubble-content">
                                <span class="bubble-sender">
                                    @turn.CharacterName
                                    @if (canSwipe)
                                    {
                                        <button type="button" title="从这一格起级联重 roll（其后角色一并重跑）" class="swipe-btn"
                                                style="margin-left: 0.4rem; font-size: 0.75rem;"
                                                @onclick="() => ReRoll(turnIndex, false)">↻</button>
                                    }
                                </span>
                                <div class="bubble-text">@((MarkupString)CleanEjsText(turn.ActionText))</div>
                                @if (!turn.Skipped && turn.DiceResult is not null)
                                {
                                    <div class="bubble-details">
                                        @if (!string.IsNullOrWhiteSpace(turn.GmJudgement))
                                        {
                                            <div class="bubble-judgement">GM 行为判定: @((MarkupString)CleanEjsText(turn.GmJudgement))</div>
                                        }
                                        <div class="dice-result-card @GetDiceSuccessClass(turn.DiceResult.SuccessLevel)">
                                            <span class="dice-icon">🎲</span>
                                            <span>@FormatDiceResult(turn.DiceResult)</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(turn.ResultResponse))
                                        {
                                            <div class="bubble-text" style="margin-top: 0.35rem; font-style: italic; color: var(--color-text-secondary);">@((MarkupString)CleanEjsText(turn.ResultResponse))</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @foreach (var systemMsg in round.Events.Where(e => e.StartsWith("填表Agent") || e.StartsWith("自动存档") || e.StartsWith("死亡回归")))
                {
                    <div class="system-event-log">🔮 @systemMsg</div>
                }
            }

            @if (phase == RoundPhase.GmRunning)
            {
                <div class="grimoire-entry gm-narrative" style="opacity: 0.85;">
                    <div class="entry-header"><span>GM 思考中...</span></div>
                    <div class="entry-body" style="font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
                        <div class="spinner-border text-warning" role="status" style="width: 1.25rem; height: 1.25rem; border-width: 2px;"></div>
                        <span>GM 正在开场并安排行动顺序...</span>
                    </div>
                </div>
            }
            else if (phase == RoundPhase.NpcRunning)
            {
                <div class="grimoire-entry gm-narrative" style="opacity: 0.85;">
                    <div class="entry-header"><span>角色响应中...</span></div>
                    <div class="entry-body" style="font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
                        <div class="spinner-border text-warning" role="status" style="width: 1.25rem; height: 1.25rem; border-width: 2px;"></div>
                        <span>在场 NPC 正在依次回应，请稍候...</span>
                    </div>
                </div>
            }
            else if (phase == RoundPhase.Finalizing)
            {
                <div class="grimoire-entry gm-narrative" style="opacity: 0.85;">
                    <div class="entry-header"><span>魔力交织中...</span></div>
                    <div class="entry-body" style="font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
                        <div class="spinner-border text-warning" role="status" style="width: 1.25rem; height: 1.25rem; border-width: 2px;"></div>
                        <span>GM 正在编织世界线并刻入编年史...</span>
                    </div>
                </div>
            }
        </section>

        <!--CONSOLE_PLACEHOLDER-->
        <section class="work-surface round-console-surface">
            @if (!hasProtagonist)
            {
                <h2>缔造命运的主角</h2>
                <p style="color: var(--color-text-secondary); margin-bottom: 1rem;">
                    当前世界线尚未铭刻主角。请先在右侧状态栏中选择或配置一个主角模板，开启起始于零的异世界旅程。
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                    @foreach (var tpl in templates)
                    {
                        <button class="btn-custom @(tpl.IsDefault == 1 ? "primary-action" : "")" type="button"
                                disabled="@isBusy" @onclick="() => ApplyTemplateAsync(tpl.TemplateId)">
                            @(tpl.IsDefault == 1 ? "★ " : "")@tpl.TemplateName
                        </button>
                    }
                </div>
            }
            else if (phase == RoundPhase.AwaitingPlayer)
            {
                <h2>书写主角的抉择</h2>
                <div class="round-console">
                    <p style="color: var(--color-text-secondary); margin: 0 0 0.5rem;">
                        GM 已铺陈开场，请先书写主角的抉择；落笔后主角将率先行动，随后在场角色依次回应。
                    </p>
                    <textarea @bind="playerInput" @bind:event="oninput" @bind:after="PersistDraft" rows="3"
                              placeholder="@(skipPlayerTurn ? "旁观模式：主角将保持沉默。" : "在此书写主角的动作、语言或决策...")"></textarea>
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem;">
                        <label class="inline-toggle">
                            <input type="checkbox" @bind="skipPlayerTurn" />
                            <span>旁观模式（跳过主角本回合行动）</span>
                        </label>
                        <label class="inline-toggle">
                            <input type="checkbox" @bind="directPlayerOutput" />
                            <span>直接输出（不经过角色agent）</span>
                        </label>
                        <button class="primary-action" type="button" disabled="@isBusy" @onclick="SubmitPlayerTurnAsync">
                            @(isBusy ? "命运编制中..." : "落笔 (提交主角行动)")
                        </button>
                    </div>
                </div>
            }
            else if (phase == RoundPhase.Interrupted)
            {
                <h2>命运暂歇</h2>
                <div class="round-console">
                    <p style="color: var(--color-text-secondary); margin: 0 0 0.75rem;">
                        本回合已手动停止。可点「继续」从断点恢复并跑完结算，或对上方任意一格点 ↻ 重 roll。
                    </p>
                    <div style="display: flex; justify-content: flex-end;">
                        <button class="primary-action" type="button" disabled="@isBusy" @onclick="ResumeRoundAsync">
                            ▶ 继续
                        </button>
                    </div>
                </div>
            }
            else
            {
                <h2>纺织新的命运线</h2>
                <p style="color: var(--color-text-secondary); margin-bottom: 1rem;">
                    点击「开始大回合」，GM 将先铺陈开场场景；随后由你书写主角的抉择，主角率先行动，在场角色再依次回应。
                </p>
                <div style="display: flex; gap: 0.75rem; justify-content: flex-end;">
                    @if (phase == RoundPhase.GmRunning || phase == RoundPhase.NpcRunning || phase == RoundPhase.Finalizing)
                    {
                        <button class="primary-action" type="button" style="background: var(--color-danger, #b03a3a); border-color: var(--color-danger, #b03a3a);" @onclick="StopRound">
                            ⏹ 停止
                        </button>
                    }
                    else
                    {
                        <button class="primary-action" type="button" disabled="@isBusy" @onclick="BeginRoundAsync">
                            ▶ 开始大回合
                        </button>
                    }
                </div>
            }
        </section>
    </div>

    <!-- 右侧可收缩状态栏 -->
    <div class="novel-sidebar @(sidebarExpanded ? "expanded" : "collapsed")">
        <button type="button" class="sidebar-toggle-btn" @onclick="() => sidebarExpanded = !sidebarExpanded">
            @if (sidebarExpanded)
            {
                <span>关闭状态栏 ▶</span>
            }
            else
            {
                <span>◀ 展开状态栏</span>
            }
        </button>

        @if (sidebarExpanded)
        {
            <div class="sidebar-header">
                🛡️ 冒险者状态栏
            </div>
            <div class="sidebar-content">
                <!-- 0. 聊天会话管理 -->
                <div class="sidebar-section">
                    <div class="sidebar-section-title" style="display: flex; justify-content: space-between; align-items: center;">
                        <span>📁 聊天会话</span>
                    </div>
                    <div class="sidebar-section-body" style="display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem;">
                        <!-- 会话下拉选择 -->
                        <div style="display: flex; gap: 0.25rem; align-items: center;">
                            <select class="form-select parchment-input" @bind="activeSessionId" @bind:after="OnSessionChangedAsync" style="flex: 1; font-size: 0.85rem; padding: 0.25rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);">
                                @foreach (var s in chatSessions)
                                {
                                    <option value="@s.SessionId">@(s.IsActive == 1 ? "★ " : "")@s.SessionName (@s.CreatedAt)</option>
                                }
                            </select>
                            <button type="button" class="btn btn-sm danger-action p-0" style="width: 24px; height: 24px; line-height: 22px; cursor: pointer; border-radius: 4px;" title="删除此会话" @onclick="DeleteCurrentSessionAsync" disabled="@(chatSessions.Count <= 1)">
                                🗑️
                            </button>
                        </div>
                        
                        <!-- 新建会话 -->
                        <div style="display: flex; gap: 0.25rem; align-items: center; border-top: 1px solid rgba(207,168,107,0.1); padding-top: 0.5rem; margin-top: 0.25rem;">
                            <input type="text" class="form-control parchment-input" placeholder="新会话名称" @bind="newSessionName" style="flex: 1; font-size: 0.75rem; padding: 0.2rem; background: var(--bg-surface); border: 1px solid var(--border-vintage); color: var(--color-text);" />
                            <button type="button" class="primary-action" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; margin: 0; line-height: 1.2;" @onclick="CreateSessionAsync">
                                新建
                            </button>
                        </div>
                        </div>
                </div>

                @if (protagonistInfo is not null)
                {
                    <!-- 1. 当前主角状态 -->
                    <div class="sidebar-section">
                        <div class="sidebar-section-title">
                            👤 冒险者状态
                        </div>
                        <div class="sidebar-section-body">
                            <div><span class="attr-label">主角名字:</span> @protagonistInfo.Name</div>
                            <div><span class="attr-label">性别/年龄:</span> @protagonistInfo.Gender / @(protagonistInfo.Age)岁</div>
                            <div><span class="attr-label">身处地点:</span> <span style="color: var(--color-gold);">@protagonistInfo.LocationName</span></div>
                            @if (!string.IsNullOrEmpty(locationRegion))
                            {
                                <div style="font-size: 0.8rem; font-style: italic; color: #a98b64; padding-left: 0.5rem;">@locationRegion</div>
                            }
                            @if (!string.IsNullOrEmpty(locationDescription))
