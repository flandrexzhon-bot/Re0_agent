    private string GetDiceSuccessClass(string? successLevel)
    {
        if (string.IsNullOrWhiteSpace(successLevel)) return "";
        var sl = successLevel.ToLower();
        if (sl.Contains("大成功") || sl.Contains("极难成功") || sl.Contains("困难成功") || sl.Contains("成功"))
        {
            return "success-level-great";
        }
        if (sl.Contains("大失败") || sl.Contains("失败"))
        {
            return "success-level-fail";
        }
        return "";
    }

    private string FormatDiceResult(DiceResult? result)
    {
        if (result is null) return "未执行";
        var outcomeText = result.Outcome == result.SuccessLevel
            ? result.Outcome
            : $"{result.Outcome}/{result.SuccessLevel}";
        var rollText = result.Roll is null
            ? string.Empty
            : $"，骰值{result.Roll}/{result.TargetAfterModifiers ?? result.Target}";
        var detail = string.IsNullOrWhiteSpace(result.Detail) ? string.Empty : $"，{result.Detail}";
        return $"{result.Command} => {outcomeText}{rollText}{detail}";
    }

    private static int StatPercent(int current, int max)
    {
        if (max <= 0) return 0;
        return Math.Clamp((int)Math.Round(current * 100.0 / max), 0, 100);
    }

    private record EquipSlot(string Key, string Label, string Icon, string[] Keywords);

    private static readonly EquipSlot[] EquipmentSlots =
    [
        new("weapon", "武器", "🗡️", ["武器", "weapon", "剑", "刀", "杖", "弓", "枪", "锤", "锁链"]),
        new("body", "上身", "🛡️", ["上身", "身体", "护甲", "甲", "袍", "衣", "armor", "body", "胸"]),
        new("legs", "下身", "👢", ["下身", "腿", "鞋", "靴", "裤", "legs", "boots", "足"]),
        new("accessory", "饰品", "💍", ["饰品", "饰", "戒指", "项链", "护符", "吊坠", "accessory", "ring"]),
    ];

    private EquipmentItem? FindEquippedBySlot(string slotKey)
    {
        var slot = EquipmentSlots.First(s => s.Key == slotKey);
        // 只看"已装备"的装备；按 equipment_type 关键字匹配槽位。
        var equipped = equipments.Where(e => e.StatusText == "已装备").ToList();

        var matched = equipped.FirstOrDefault(e =>
            slot.Keywords.Any(k =>
                e.EquipmentType.Contains(k, StringComparison.OrdinalIgnoreCase)
                || e.EquipmentName.Contains(k, StringComparison.OrdinalIgnoreCase)));

        if (matched is not null) return matched;

        // 饰品槽兜底：未归入前三类的已装备物品落到饰品槽。
        if (slotKey == "accessory")
        {
            return equipped.FirstOrDefault(e => !EquipmentSlots
                .Where(s => s.Key != "accessory")
                .Any(s => s.Keywords.Any(k =>
                    e.EquipmentType.Contains(k, StringComparison.OrdinalIgnoreCase)
                    || e.EquipmentName.Contains(k, StringComparison.OrdinalIgnoreCase))));
        }

        return null;
    }

